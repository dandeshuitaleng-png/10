<button class="game-button appearance-{{appearance}} {{kind}} skin-{{skin}} {{emphasis?'is-home-action':''}} {{touching?'is-touching':''}}" disabled="{{disabled || loading}}" loading="{{loading}}" bindtap="press" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"><view class="button-inset" /><text class="button-label">{{label}}</text><view wx:if="{{emphasis}}" class="action-forward" aria-hidden="true"><image src="/assets/icons/next.png" mode="aspectFit" /></view></button>
