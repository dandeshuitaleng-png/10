/* Two review directions. The current production layout remains the default. */
.game-device.activity-page.home-layout.home-design-map .activity-header,
.game-device.activity-page.home-layout.home-design-guide .activity-header{background:var(--pale);color:var(--ink)}
.game-device.activity-page.home-layout .home-direction-caption{display:flex;justify-content:center;align-items:center;gap:6px;height:22px;font-size:12px;line-height:20px;color:var(--muted)}
.home-direction-caption game-icon{width:13px;height:13px}
.game-device.activity-page.home-layout.home-design-map .activity-header{padding-bottom:10px}
.game-device.activity-page.home-layout.home-design-map .activity-hud,
.game-device.activity-page.home-layout.home-design-map .activity-progress-row{height:44px;min-height:44px}
.game-device.activity-page.home-layout.home-design-map .activity-hud{padding:0 12px;border:1px solid var(--edge);border-radius:18px;background:#fffefa;box-shadow:0 3px 0 var(--shadow);box-sizing:border-box}
.game-device.activity-page.home-layout.home-design-map .activity-progress-copy{font-size:12px;gap:8px}
.game-device.activity-page.home-layout.home-design-map .activity-links{margin-top:8px;box-shadow:none;gap:8px}
.game-device.activity-page.home-layout.home-design-map .activity-links button{border:1px solid var(--edge);border-radius:14px;background:#fffaf0;box-shadow:0 2px 0 var(--shadow);font-weight:600;color:var(--ink)}
.game-device.activity-page.home-layout.home-design-map .route-caption{background:#fffdf4f5;box-shadow:0 4px 10px #33522514}
.game-device.activity-page.home-layout.home-design-map .panel-footer{background:var(--pale);border-top:0;padding-top:10px}

.game-device.activity-page.home-layout.home-design-guide .activity-header{padding-bottom:12px}
.game-device.activity-page.home-layout.home-design-guide .activity-hud{display:none}
.game-device.activity-page.home-layout .home-guide-card{box-sizing:border-box;height:104px;margin:0 0 12px;padding:12px 14px;display:flex;align-items:center;gap:10px;border:1px solid var(--edge);border-radius:20px;background:linear-gradient(110deg,#fffdf5,#ffffff);box-shadow:0 4px 0 var(--shadow)}
.home-guide-copy{flex:1;min-width:0}
.home-guide-eyebrow{display:block;font-size:11px;line-height:18px;color:var(--muted)}
.home-guide-chapter{display:block;max-width:100%;font-size:19px;line-height:30px;font-weight:700;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.home-guide-summary{display:block;font-size:12px;line-height:22px;color:var(--muted)}
.home-guide-track{height:4px;width:100%;margin-top:4px;background:var(--edge);border-radius:4px;overflow:hidden}
.home-guide-track view{height:4px;background:var(--accent);border-radius:4px}
.home-guide-avatar{display:block;width:68px;height:80px;flex:none;object-fit:contain}
.game-device.activity-page.home-layout.home-design-guide .activity-links{height:48px;min-height:48px;box-shadow:none;gap:6px}
.game-device.activity-page.home-layout.home-design-guide .activity-links button{height:48px;min-height:48px;background:transparent;border:1px solid var(--edge);border-radius:12px;font-size:12px;color:var(--ink)}
.game-device.activity-page.home-layout.home-design-guide .panel-scroll-frame{margin:0 12px 12px;border:3px solid #fffdf7;border-radius:22px;box-shadow:0 0 0 1px var(--edge);box-sizing:border-box;background:#fffdf7}
.game-device.activity-page.home-layout.home-design-guide .panel-footer{padding-left:12px;padding-right:12px;padding-top:0;border-top:0;background:var(--pale)}
.game-device.activity-page.home-layout.home-design-guide .route-caption{background:#fffef9;box-shadow:0 2px 5px #29441412}
@media(max-width:350px){.home-guide-chapter{font-size:17px}.home-guide-avatar{width:58px;height:74px}.game-device.activity-page.home-layout .home-guide-card{padding-left:12px;padding-right:10px;gap:8px}.game-device.activity-page.home-layout.home-design-map .activity-hud{padding-left:8px;padding-right:8px}}
