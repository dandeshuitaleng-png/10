/* Two review directions. The current production layout remains the default. */
.game-device.activity-page.home-layout.home-design-map .activity-header,
.game-device.activity-page.home-layout.home-design-guide .activity-header{background:var(--pale);color:var(--ink)}
.game-device.activity-page.home-layout .home-direction-caption{display:flex;justify-content:center;align-items:center;gap:6px;height:22px;font-size:12px;line-height:20px;color:var(--muted)}
.home-direction-caption game-icon{width:13px;height:13px}
.game-device.activity-page.home-layout.home-design-map .activity-header{padding-bottom:10px}
.game-device.activity-page.home-layout.home-design-map .activity-hud,
.game-device.activity-page.home-layout.home-design-map .activity-progress-row{height:44px;min-height:44px}
.game-device.activity-page.home-layout.home-design-map .activity-hud{padding:0 12px;border:1px solid var(--edge);border-radius:18px;background:#fffefa;box-shadow:0 3px 0 var(--shadow);box-sizing:border-box}
.game-device.activity-page.home-layout.home-design-map .activity-progress-copy{font-size:12px;gap:8px}
.game-device.activity-page.home-layout.home-design-map .activity-links{margin-top:8px;box-shadow:none;gap:8px}
.game-device.activity-page.home-layout.home-design-map .activity-links button{border:1px solid var(--edge);border-radius:14px;background:#fffaf0;box-shadow:0 2px 0 var(--shadow);font-weight:600;color:var(--ink)}
.game-device.activity-page.home-layout.home-design-map .route-caption{background:#fffdf4f5;box-shadow:0 4px 10px #33522514}
.game-device.activity-page.home-layout.home-design-map .panel-footer{background:var(--pale);border-top:0;padding-top:10px}

/* B: softer pigments, warm paper and matte ink. One illustrated journey only. */
.game-device.home-design-guide.skin-ecology{--paper:#ECF0E3;--paper-ink:#385C47;--paper-muted:#6B7F68;--paper-edge:#CDD5BD;--paper-accent:#4E755D}
.game-device.home-design-guide.skin-red{--paper:#F4E6DE;--paper-ink:#793E35;--paper-muted:#966F62;--paper-edge:#DEC2B5;--paper-accent:#A64F40}
.game-device.home-design-guide.skin-culture{--paper:#F0E7D5;--paper-ink:#624631;--paper-muted:#8D775D;--paper-edge:#D8C8AC;--paper-accent:#77533C}
.game-device.home-design-guide.skin-industry{--paper:#F5EBCF;--paper-ink:#725021;--paper-muted:#927A4F;--paper-edge:#DCCD9C;--paper-accent:#8C6426}
.game-device.activity-page.home-layout.home-design-guide{--ink:var(--paper-ink);--muted:var(--paper-muted);--accent:var(--paper-accent);--edge:var(--paper-edge);--pale:var(--paper);background:var(--paper)}
.game-device.activity-page.home-layout.home-design-guide .activity-header{background:var(--paper);padding-bottom:14px;color:var(--paper-ink)}
.game-device.activity-page.home-layout.home-design-guide .activity-title-art{opacity:.94}
.home-paper-intro{height:24px;display:flex;justify-content:center;align-items:center;gap:8px;font-size:11px;line-height:18px;color:var(--paper-muted)}
.home-paper-series{padding:0 7px;border:1px solid var(--paper-edge);border-radius:3px;font-size:9px;letter-spacing:1px;color:var(--paper-ink)}
.game-device.activity-page.home-layout.home-design-guide .activity-hud,
.game-device.activity-page.home-layout.home-design-guide .activity-progress-row{height:44px;min-height:44px}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-row{border-bottom:1px solid var(--paper-edge)}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-copy,
.game-device.activity-page.home-layout.home-design-guide .activity-progress-value,
.game-device.activity-page.home-layout.home-design-guide .activity-points{color:var(--paper-ink)}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-total{color:var(--paper-muted)}
.game-device.activity-page.home-layout.home-design-guide .activity-links{height:44px;min-height:44px;margin-top:8px;gap:6px;box-shadow:none}
.game-device.activity-page.home-layout.home-design-guide .activity-links button{height:44px;min-height:44px;background:#FFFBF1;border:1px solid var(--paper-edge);border-radius:8px;font-size:12px;font-weight:500;color:var(--paper-ink);box-shadow:0 2px 0 #6856370A}
.game-device.activity-page.home-layout.home-design-guide .panel-scroll-frame{margin:0 12px 12px;padding:5px;border:1px solid var(--paper-edge);border-radius:18px;box-sizing:border-box;background:#FFFBF1;box-shadow:0 3px 8px #6856370A}
.game-device.activity-page.home-layout.home-design-guide .route-canvas{background-color:#F7F0DF!important}
.game-device.activity-page.home-layout.home-design-guide .route-scene{opacity:.76}
.game-device.activity-page.home-layout.home-design-guide .route-caption{background:#FFFCF4F5;border:1px solid #E2D6BA;color:var(--paper-ink);box-shadow:0 2px 0 #6856370D;border-radius:8px}
.game-device.activity-page.home-layout.home-design-guide .route-caption-name{font-size:17px;font-weight:600;color:var(--paper-ink)}
.game-device.activity-page.home-layout.home-design-guide .route-caption-label,
.game-device.activity-page.home-layout.home-design-guide .route-caption-state,
.game-device.activity-page.home-layout.home-design-guide .route-caption-reward{color:var(--paper-muted)}
.game-device.activity-page.home-layout.home-design-guide .route-stop.current .route-caption{border:2px solid var(--paper-accent)}
.game-device.activity-page.home-layout.home-design-guide .route-stop.current .route-caption-state{color:var(--paper-accent);font-weight:700}
.game-device.activity-page.home-layout.home-design-guide .panel-footer{padding:8px 12px var(--safe-bottom);border-top:0;background:var(--paper)}
.game-device.activity-page.home-layout.home-design-guide .map-edge-top{background:linear-gradient(180deg,#F7F0DF99,#F7F0DF00)}
.game-device.activity-page.home-layout.home-design-guide .map-edge-bottom{background:linear-gradient(0deg,#F7F0DF99,#F7F0DF00)}
@media(max-width:350px){.game-device.activity-page.home-layout.home-design-map .activity-hud{padding-left:8px;padding-right:8px}.home-paper-intro{gap:6px;font-size:10px}}
