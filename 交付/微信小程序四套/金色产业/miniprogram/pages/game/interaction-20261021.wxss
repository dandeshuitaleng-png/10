/* Keep the native scroll viewport and all answer states inside their parent.
 * A selected answer changes its inset edge, never its width or outer outline. */
.game-device.feedback-20261019 .panel-body,
.game-device.feedback-20261019 .panel-body-inner,
.game-device.feedback-20261019 .options,
.game-device.feedback-20261019 button.option{box-sizing:border-box;min-width:0;max-width:100%}
.game-device.feedback-20261019 .options{width:100%}
.game-device.feedback-20261019 button.option{width:100%;min-height:56px;height:auto;margin:0;flex-shrink:0;overflow:hidden;transform-origin:center;transition:transform 90ms ease-out,background-color 90ms ease-out,box-shadow 90ms ease-out}
.game-device.feedback-20261019 button.option .option-text{min-width:0;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.game-device.feedback-20261019 button.option.selected{box-shadow:inset 0 0 0 1px var(--accent)}
.game-device.feedback-20261019 button.option.correct{box-shadow:inset 0 0 0 1px #50904c}
.game-device.feedback-20261019 button.is-touching,
.game-device.feedback-20261019 button.native-pressed{transform:scale(.975);filter:brightness(.97)}
.game-device.feedback-20261019 button.option.is-touching,
.game-device.feedback-20261019 button.option.native-pressed{box-shadow:inset 0 0 0 2px var(--accent),inset 0 2px 5px #254c161a}
.game-device.feedback-20261019 button.option[disabled]{transform:none;filter:none}
.game-device.feedback-20261019[data-route="quiz"] .panel-body-inner{padding-bottom:16px}
.game-device.feedback-20261019.reduced-motion button.is-touching,
.game-device.feedback-20261019.reduced-motion button.native-pressed{transform:none}
@media(prefers-reduced-motion:reduce){
 .game-device.feedback-20261019 button.option{transition:none}
 .game-device.feedback-20261019 button.is-touching,
 .game-device.feedback-20261019 button.native-pressed{transform:none}
}
