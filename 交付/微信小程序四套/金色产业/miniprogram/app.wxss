page{margin:0;background:#504b3a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:16px;line-height:1.5}view,scroll-view,text,button,image,video{box-sizing:border-box}button{padding:0;margin:0;border:0;font:inherit;color:inherit;line-height:1.5;cursor:pointer}button::after{border:0}image{display:block}game-button{display:block;flex-shrink:0}game-icon{display:inline-flex;width:24px;height:24px;flex-shrink:0;vertical-align:middle}