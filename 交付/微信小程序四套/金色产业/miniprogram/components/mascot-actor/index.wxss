/* Deliberate touch: fast first movement, complete one local gesture, immediate per-tap accents. */
.pose-welcome.is-responding,.pose-celebrate.is-responding{--actor-duration:1350ms}
.pose-observe.is-responding{--actor-duration:1450ms}
.pose-think.is-responding{--actor-duration:1500ms}
.is-responding .response-mark{animation-duration:300ms;animation-timing-function:cubic-bezier(.16,1,.3,1);animation-delay:0ms}
.is-responding.touch-phase-0 .response-mark{animation-name:touch-accent-0}
.is-responding.touch-phase-1 .response-mark{animation-name:touch-accent-1}
@keyframes touch-accent-0{0%,100%{opacity:0}8%,54%{opacity:.9}}
@keyframes touch-accent-1{0%,100%{opacity:0}8%,54%{opacity:.9}}

/* One persistent image strip owns each seasonal body in maps and dialogs. */
.map-motion-window{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.map-motion-strip{position:absolute;left:0;top:0;display:block;width:1600%;height:200%;max-width:none;transform:translateX(0);pointer-events:none}
.is-responding .map-motion-strip{top:-100%}
.is-playing.phase-0 .map-motion-strip{animation:map-frames-0 var(--actor-duration) steps(15,end) both}
.is-playing.phase-1 .map-motion-strip{animation:map-frames-1 var(--actor-duration) steps(15,end) both}
@keyframes map-frames-0{from{transform:translateX(0)}to{transform:translateX(-93.75%)}}
@keyframes map-frames-1{from{transform:translateX(0)}to{transform:translateX(-93.75%)}}
@media(prefers-reduced-motion:reduce){.actor-original .map-motion-strip{animation:none!important;top:0!important;transform:none!important}}
@media(prefers-reduced-motion:reduce){.actor-original .actor-response-marks,.actor-original .eye-region,.actor-original .prop-glint,.actor-original .antenna-region{display:none!important}.actor-original .eye-copy,.actor-original .prop-shine,.actor-original .gesture-plane,.actor-original .antenna-pivot{animation:none!important;transform:none!important}.actor-extension .extension-plane,.actor-extension .extension-part{animation:none!important;transform:none!important}}

/* Winter: 32 pre-rendered frames, same persistent image and fixed feet. */
.pose-think .map-motion-strip{height:400%}
.pose-think.is-responding .map-motion-strip{top:-200%}
.pose-think.is-playing.phase-0 .map-motion-strip{animation:winter-frames-0 var(--actor-duration) steps(1,end) both}
