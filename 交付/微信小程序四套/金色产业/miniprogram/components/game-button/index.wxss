:host{display:block;width:100%;flex-shrink:0}
.game-button{--fill-top:#a85f2a;--fill-bottom:#8d451b;--fill-angle:180deg;--label:#fff;--button-edge:#c98245;--button-shadow:#a3632630;position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-width:0;max-width:none;min-height:52px;margin:0;padding:10px 18px;border:1px solid var(--button-edge);border-radius:26px;background:linear-gradient(180deg,var(--fill-top),var(--fill-bottom));color:var(--label);box-shadow:none;font:600 18px/26px -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;letter-spacing:0;text-shadow:none;transition:transform .12s,opacity .12s}
.game-button.skin-culture{--fill-top:#F7E7CF;--fill-bottom:#EFD9B9;--fill-angle:180deg;--label:#674524;--button-edge:#E3CAAA;--button-shadow:#00000000;--secondary-label:#543B26;--disabled-fill:#EEE7DD;--disabled-edge:#DED0BC;--disabled-label:#776049}
.game-button.skin-red{--fill-top:#FFE8DC;--fill-bottom:#FADACB;--fill-angle:180deg;--label:#7B3B2D;--button-edge:#EDC3B3;--button-shadow:#00000000;--secondary-label:#532E28;--disabled-fill:#F1E5DF;--disabled-edge:#E4D0C5;--disabled-label:#805B50}
.game-button.skin-industry{--fill-top:#FFF1C4;--fill-bottom:#FFE8A8;--fill-angle:100deg;--label:#674310;--button-edge:#EAD493;--button-shadow:#00000000;--secondary-label:#5A431D;--disabled-fill:#EFE9D8;--disabled-edge:#DED4B4;--disabled-label:#78643B}
.game-button.skin-ecology{--fill-top:#EBF8E2;--fill-bottom:#DEF0D4;--fill-angle:100deg;--label:#315C3C;--button-edge:#C8DFBC;--button-shadow:#00000000;--secondary-label:#2B4C3A;--disabled-fill:#E7EDDF;--disabled-edge:#D2DECA;--disabled-label:#5E735B}
.game-button.game-button{width:100%;max-width:none;min-width:0;margin:0;flex:1}
.game-button.game-button::after{content:none;display:none;border:0;box-shadow:none}
.button-inset{display:none}.button-label{position:relative;z-index:1}
.game-button.secondary{min-height:44px;background:transparent;color:var(--secondary-label);border-color:#D8DAD2;box-shadow:none;font-size:15px;line-height:22px;font-weight:500;border-radius:22px}
.game-button.primary.is-home-action{height:52px;min-height:52px;padding:9px 44px;gap:0;font-size:18px;line-height:26px;overflow:hidden}
.is-home-action .button-label{display:block;flex:1;min-width:0;text-align:center;white-space:nowrap}
.action-forward{position:absolute;right:16px;top:12px;display:flex;align-items:center;justify-content:center;flex:0 0 16px;box-sizing:border-box;width:16px;height:26px;border:0;border-radius:0;background:transparent;box-shadow:none}
.action-forward image{display:block;width:15px;height:15px}
.game-button.is-touching,.game-button.native-pressed,.game-button:active{transform:scale(.985);opacity:.9;box-shadow:none}
.game-button[disabled]{background:var(--disabled-fill,#E4EADF);color:var(--disabled-label,#677360);border-color:var(--disabled-edge,#DCE5D5);box-shadow:none;text-shadow:none}
.game-button[disabled] .button-label{color:var(--disabled-label,#687262);opacity:1}
.game-button[disabled] .action-forward{opacity:.55}
@media(max-width:350px){.game-button.primary.is-home-action{padding-left:36px;padding-right:36px;gap:0;font-size:17px;line-height:24px}}
@media(prefers-reduced-motion:reduce){.game-button{transition:none}.game-button.is-touching,.game-button.native-pressed,.game-button:active{transform:none}}

/* B keeps its cardbook shape and press motion, using the same reference palette. */
.game-button.primary.appearance-paper{border:1px solid var(--button-edge);border-radius:16px;background:linear-gradient(180deg,var(--fill-top),var(--fill-bottom));color:var(--label);box-shadow:none;font-weight:700;text-shadow:none}
.game-button.primary.appearance-paper.is-touching,.game-button.primary.appearance-paper.native-pressed,.game-button.primary.appearance-paper:active{transform:translateY(2px) scale(.985);opacity:.9;box-shadow:none}
.game-button.appearance-paper[disabled]{background:#E4EADF;color:#677360;border-color:#DCE5D5;box-shadow:none;text-shadow:none}
@media(prefers-reduced-motion:reduce){.game-button.primary.appearance-paper.is-touching,.game-button.primary.appearance-paper.native-pressed,.game-button.primary.appearance-paper:active{transform:none}}

@import "theme-tone-20261023.wxss";
