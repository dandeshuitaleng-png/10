/* Two review directions. The current production layout remains the default. */
.game-device.activity-page.home-layout.home-design-map .activity-header,
.game-device.activity-page.home-layout.home-design-guide .activity-header{background:var(--pale);color:var(--ink)}
.game-device.activity-page.home-layout .home-direction-caption{display:flex;justify-content:center;align-items:center;gap:6px;height:22px;font-size:12px;line-height:20px;color:var(--muted)}
.home-direction-caption game-icon{width:13px;height:13px}
.game-device.activity-page.home-layout.home-design-map .activity-header{padding-bottom:10px}
.game-device.activity-page.home-layout.home-design-map .activity-hud,
.game-device.activity-page.home-layout.home-design-map .activity-progress-row{height:44px;min-height:44px}
.game-device.activity-page.home-layout.home-design-map .activity-hud{padding:0 12px;border:1px solid var(--edge);border-radius:18px;background:#fffefa;box-shadow:0 3px 0 var(--shadow);box-sizing:border-box}
.game-device.activity-page.home-layout.home-design-map .activity-progress-copy{font-size:12px;gap:8px}
.game-device.activity-page.home-layout.home-design-map .activity-links{margin-top:8px;box-shadow:none;gap:8px}
.game-device.activity-page.home-layout.home-design-map .activity-links button{border:1px solid var(--edge);border-radius:14px;background:#fffaf0;box-shadow:0 2px 0 var(--shadow);font-weight:600;color:var(--ink)}
.game-device.activity-page.home-layout.home-design-map .route-caption{background:#fffdf4f5;box-shadow:0 4px 10px #33522514}
.game-device.activity-page.home-layout.home-design-map .panel-footer{background:var(--pale);border-top:0;padding-top:10px}

/* B — Figma 1:67 (color blocks) + image74 / 1:76 (story-card album).
   Approved theme art in picture windows, original IP, equal collectible cards. */
/* Reuse the approved reference-20261020 tokens; no separate muted B palette. */
.game-device.home-design-guide{--chapter-frame:var(--panel-edge);--chapter-page:var(--pale);--chapter-ink:var(--ink);--chapter-accent:var(--accent);--chapter-soft:var(--theme-fill);--chapter-tint:var(--pale);--chapter-muted:var(--muted);--chapter-line:var(--edge);--chapter-shadow:var(--ribbon-shadow)}
.game-device.activity-page.home-layout.home-design-guide{background:var(--chapter-page)}
.game-device.activity-page.home-layout.home-design-guide .environment,.game-device.activity-page.home-layout.home-design-guide .theme-panel::before,.game-device.activity-page.home-layout.home-design-guide .theme-panel::after{display:none}
.game-device.activity-page.home-layout.home-design-guide .activity-header{background:var(--chapter-page);padding-bottom:8px;color:var(--chapter-ink)}
.home-paper-intro{height:20px;display:flex;justify-content:center;align-items:center;gap:7px;font-size:11px;line-height:18px;color:var(--chapter-muted)}
.home-paper-series{font-size:10px;line-height:16px;border-right:1px solid var(--chapter-line);padding-right:7px}
.game-device.activity-page.home-layout.home-design-guide .activity-hud,
.game-device.activity-page.home-layout.home-design-guide .activity-progress-row{height:44px;min-height:44px}
.game-device.activity-page.home-layout.home-design-guide .activity-hud{margin-top:0;padding:0 2px}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-copy{font-size:12px;gap:8px}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-value{font-size:25px;font-weight:800;color:var(--chapter-ink);letter-spacing:-1px}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-total{font-size:12px;font-weight:500;letter-spacing:0;color:var(--chapter-muted)}
.game-device.activity-page.home-layout.home-design-guide .activity-progress-track{display:none}
.game-device.activity-page.home-layout.home-design-guide .activity-points{font-size:13px;min-height:44px;color:var(--chapter-ink)}
.game-device.activity-page.home-layout.home-design-guide .panel-scroll-frame{margin:0;padding:0;background:transparent;border:0;border-radius:0;box-shadow:none}
.game-device.activity-page.home-layout.home-design-guide .panel-body-inner{padding:0}
.chapter-board{position:relative;background:var(--panel);box-sizing:border-box;border-top:1px solid #FFFFFF;box-shadow:inset 0 3px 8px var(--chapter-shadow)}
.chapter-tools{position:absolute;top:16px;left:16px;right:16px;height:60px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.game-device.activity-page.home-layout.home-design-guide .chapter-tools button.chapter-tool{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;margin:0;padding:5px 3px;width:100%;max-width:100%;box-sizing:border-box;height:60px;min-height:60px;min-width:0;border:1px solid var(--chapter-line);border-radius:10px;background:linear-gradient(180deg,#FFFFFF,#FFFFFFF0);color:var(--chapter-ink);box-shadow:0 3px 0 var(--chapter-shadow),0 5px 8px var(--chapter-shadow),inset 0 1px #FFFFFF;font-size:12px;line-height:18px;font-weight:600}
.chapter-tool-mark{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:27px;height:27px;border:1px solid var(--chapter-line);border-radius:50%;background:linear-gradient(155deg,#FFFFFF,var(--chapter-tint));box-shadow:0 1px 0 var(--chapter-line),inset 0 1px #FFFFFF}
.chapter-tool-mark game-icon{display:block;width:17px;height:17px}
.chapter-tool>game-icon:last-child{display:none}
.chapter-directory-heading{position:absolute;left:18px;right:18px;height:24px;display:flex;align-items:center;justify-content:space-between;font-size:15px;line-height:24px;font-weight:700;color:var(--chapter-ink)}
.chapter-directory-progress{display:flex;align-items:center;gap:8px}
.chapter-directory-count{font-size:11px;font-weight:600;color:var(--chapter-ink)}
.chapter-progress-stamps{display:flex;gap:3px;width:76px;height:13px;align-items:center;overflow:hidden}
.chapter-progress-stamp{flex:1;min-width:2px;max-width:16px;height:10px;border:1px solid var(--chapter-line);border-radius:3px;background:#FFFFFFB3;display:flex;align-items:center;justify-content:center}
.chapter-progress-stamp.completed{background:var(--chapter-tint);border-color:var(--chapter-accent)}
.chapter-progress-stamp.current,.chapter-progress-stamp.today-locked{border-color:var(--chapter-accent);background:#FFFFFF}
.chapter-progress-stamp game-icon{width:9px;height:9px}
.chapter-progress-dot{width:4px;height:4px;border-radius:50%;background:var(--chapter-accent)}
.chapter-card{position:absolute;box-sizing:border-box;min-width:0;border-radius:10px;color:var(--chapter-ink)}
.chapter-card::before{content:"";position:absolute;left:4px;right:-3px;top:-3px;bottom:3px;border:1px solid var(--chapter-line);border-radius:10px;background:#FFFFFF;transform:rotate(1.2deg);box-shadow:0 3px 0 var(--chapter-shadow);pointer-events:none}
.game-device.activity-page.home-layout.home-design-guide button.chapter-open{position:relative;width:100%;height:100%;box-sizing:border-box;display:block;margin:0;padding:0;border:2px solid var(--chapter-line);border-radius:10px;background:#FFFFFF;text-align:left;line-height:1.4;white-space:normal;overflow:hidden;color:var(--chapter-ink);box-shadow:0 3px 0 var(--chapter-shadow),0 6px 8px var(--chapter-shadow),inset 0 1px #FFFFFF;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif}
.game-device.activity-page.home-layout.home-design-guide .chapter-card.current button.chapter-open,.game-device.activity-page.home-layout.home-design-guide .chapter-card.today-locked button.chapter-open{border-color:var(--chapter-frame);background:linear-gradient(150deg,#FFFFFF,var(--chapter-page));box-shadow:0 3px 0 var(--chapter-shadow),0 0 0 2px var(--chapter-soft),0 6px 8px var(--chapter-shadow)}
.game-device.activity-page.home-layout.home-design-guide .chapter-card.completed button.chapter-open{background:#FFFFFF}
.chapter-art-window{position:absolute;left:8px;right:8px;top:8px;height:72px;overflow:hidden;border:1px solid var(--chapter-line);border-radius:5px;background:var(--chapter-tint);box-sizing:border-box;pointer-events:none}
.chapter-art-image{position:absolute;left:0;width:100%;display:block;pointer-events:none}
.chapter-card.locked .chapter-art-image{filter:saturate(.8);opacity:.55}
.chapter-mystery{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#FFFFFF80,var(--chapter-page));color:var(--chapter-accent)}
.chapter-mystery>text{font-size:47px;font-weight:800;line-height:62px;text-shadow:0 2px #FFFFFF;opacity:.75;transform:rotate(-8deg)}
.chapter-sequence{position:absolute;left:3px;top:6px;z-index:2;color:var(--chapter-ink);font-weight:800;display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:22px;padding:0 5px;border:1px solid var(--chapter-frame);border-radius:4px;background:linear-gradient(180deg,#FFFFFF,var(--chapter-soft));box-shadow:0 2px 0 var(--chapter-shadow),inset 0 1px #FFFFFFC9;font-size:11px;line-height:20px}
.chapter-status-mark{position:absolute;right:2px;bottom:2px;display:flex;align-items:center;gap:2px;padding:1px 4px;border:1px solid #FFFFFFA6;border-radius:4px;font-size:9px;line-height:16px;background:var(--chapter-accent);color:#FFFFFF;box-shadow:0 1px 0 var(--chapter-shadow)}
.chapter-status-mark game-icon{display:block;width:13px;height:13px}
.chapter-status-mark{box-sizing:border-box;width:22px;height:22px;justify-content:center;padding:2px}
.chapter-status-mark text{display:none}
.chapter-complete-stamp{position:absolute;right:3px;bottom:3px;width:36px;height:36px;box-sizing:border-box;border:2px solid var(--chapter-accent);border-radius:50%;background:#FFFFFF;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(-12deg);color:var(--chapter-ink);box-shadow:0 1px 0 #FFFFFF80}
.chapter-complete-stamp game-icon{display:block;width:19px;height:17px}
.chapter-complete-stamp text{font-size:8px;font-weight:700;line-height:10px}
.chapter-card-copy{position:absolute;left:10px;right:10px;top:86px}
.chapter-card-title{display:block;font-size:17px;line-height:23px;font-weight:700;letter-spacing:0}
.chapter-card-state{display:block;margin-top:2px;font-size:11px;line-height:16px;color:var(--chapter-muted)}
.chapter-card.current .chapter-card-state,.chapter-card.today-locked .chapter-card-state{color:var(--chapter-ink)}
.chapter-card-reward{position:absolute;left:10px;right:10px;bottom:7px;display:flex;align-items:center;gap:4px;padding-top:4px;border-top:1px solid var(--chapter-line);font-size:10px;line-height:14px;color:var(--chapter-ink)}
.chapter-card-reward game-icon{display:block;width:12px;height:12px}
.chapter-seal{position:absolute;right:5px;bottom:4px;display:flex;align-items:center;justify-content:center;width:23px;height:26px;box-sizing:border-box;border:1px solid var(--chapter-line);border-radius:7px;background:linear-gradient(150deg,#FFFFFF,var(--chapter-tint));box-shadow:0 2px 0 var(--chapter-shadow),inset 0 1px #FFFFFF}
.chapter-seal game-icon{width:15px;height:15px}
.game-device.activity-page.home-layout.home-design-guide .chapter-card .chapter-mascot{position:absolute;left:50%;right:auto;top:12px;bottom:auto;z-index:3;margin:0 0 0 -30px;width:60px;height:70px;padding:0;min-height:44px;border:0;background:transparent;box-shadow:none;overflow:visible;border-radius:10px}
.game-device.activity-page.home-layout.home-design-guide .chapter-mascot::after{display:none;border:0}
.chapter-cheer{position:absolute;z-index:4;right:5px;top:29px;padding:3px 5px;border:1px solid var(--chapter-frame);border-radius:7px 7px 7px 0;background:#FFFFFF;color:var(--chapter-ink);font-size:10px;line-height:14px;font-weight:700;box-shadow:0 2px 0 var(--chapter-shadow);pointer-events:none}
.game-device.activity-page.home-layout.home-design-guide .panel-footer{background:var(--chapter-page);border:0;padding-top:8px;box-shadow:none}
.game-device.activity-page.home-layout.home-design-guide .map-scroll-hint{display:none}
.chapter-tool::after,.chapter-open::after{display:none;border:0}
.game-device.activity-page.home-layout.home-design-guide button.chapter-tool.is-touching,.game-device.activity-page.home-layout.home-design-guide button.chapter-tool.native-pressed,.game-device.activity-page.home-layout.home-design-guide button.chapter-open.is-touching,.game-device.activity-page.home-layout.home-design-guide button.chapter-open.native-pressed{transform:translateY(2px) scale(.985);filter:brightness(.98);box-shadow:0 1px 0 var(--chapter-line),inset 0 1px #FFFFFF80}
.chapter-open,.chapter-tool{transition:transform .12s,box-shadow .12s,filter .12s}
@media(max-width:350px){.home-paper-intro{font-size:10px}.chapter-card-title{font-size:16px}.chapter-card-reward{font-size:10px}.chapter-status-mark{padding:1px 3px;font-size:9px;gap:1px}.chapter-progress-stamps{width:62px}}
@media(prefers-reduced-motion:reduce){.chapter-open,.chapter-tool{transition:none}.game-device.activity-page.home-layout.home-design-guide button.chapter-tool.is-touching,.game-device.activity-page.home-layout.home-design-guide button.chapter-tool.native-pressed,.game-device.activity-page.home-layout.home-design-guide button.chapter-open.is-touching,.game-device.activity-page.home-layout.home-design-guide button.chapter-open.native-pressed{transform:none}}
