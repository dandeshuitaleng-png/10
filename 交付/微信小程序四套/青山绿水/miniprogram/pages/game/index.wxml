<view data-game="{{skin.gameId}}" data-route="{{route}}" data-modal="{{modal}}" class="game-device feedback-20261019 skin-{{skin.gameId}} home-design-{{homeDesign}} {{reducedMotion?'reduced-motion':''}} chapter-{{chapterStyle.key}} {{skin.gameId!=='culture'?'landscape-home':''}} {{route==='home'||route==='levels'?'activity-page home-layout':''}} {{smallScreen?'small-screen':''}}" style="{{shellStyle}}">
  <view class="motion-preference-probe" aria-hidden="true" /><view class="environment"><image src="{{scene}}" mode="aspectFill" /></view>
  <button wx:if="{{soundAvailable}}" id="sound-settings" class="sound-button {{pressedKey==='press-1'?'is-touching':''}}" bindtap="openSoundSettings" aria-label="打开声音设置" aria-expanded="{{soundSettingsOpen}}" data-press-key="press-1" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><image src="/assets/icons/settings.png" mode="aspectFit" /></button>
  <view wx:if="{{soundSettingsOpen}}" class="sound-settings-mask" catchtap="closeSoundSettings">
    <view class="sound-settings-panel" catchtap="blockTap" role="dialog" aria-label="声音设置" aria-modal="true">
      <view class="sound-settings-heading"><view><text class="sound-settings-title">声音设置</text><text class="sound-settings-caption">{{skin.name}}</text></view><button id="sound-settings-close" class="sound-settings-close {{pressedKey==='press-2'?'is-touching':''}}" bindtap="closeSoundSettings" aria-label="关闭声音设置" data-press-key="press-2" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="close" /></button></view>
      <view class="sound-settings-group">
        <view class="sound-settings-row"><view class="sound-settings-label"><game-icon name="sound-on" /><text>背景音乐</text></view><view class="sound-switch-hit" data-channel="music" bindtap="toggleSoundChannel"><switch catchtap="blockTap" id="music-switch" checked="{{musicEnabled}}" color="{{skin.accent}}" data-channel="music" bindchange="changeSoundChannel" aria-label="背景音乐开关" /></view></view>
        <view class="sound-slider-row"><slider id="music-volume" value="{{musicVolume}}" min="0" max="100" step="1" activeColor="{{skin.accent}}" backgroundColor="#E5E8DF" block-color="#FFFFFF" block-size="24" data-channel="music" bindchanging="changingSoundVolume" bindchange="changeSoundVolume" aria-label="背景音乐音量" /><text class="sound-volume-value">{{musicVolume}}%</text></view>
      </view>
      <view class="sound-settings-group">
        <view class="sound-settings-row"><view class="sound-settings-label"><game-icon name="check" /><text>互动音效</text></view><view class="sound-switch-hit" data-channel="effects" bindtap="toggleSoundChannel"><switch catchtap="blockTap" id="effects-switch" checked="{{effectsEnabled}}" color="{{skin.accent}}" data-channel="effects" bindchange="changeSoundChannel" aria-label="互动音效开关" /></view></view>
        <view class="sound-slider-row"><slider id="effects-volume" value="{{effectsVolume}}" min="0" max="100" step="1" activeColor="{{skin.accent}}" backgroundColor="#E5E8DF" block-color="#FFFFFF" block-size="24" data-channel="effects" bindchanging="changingSoundVolume" bindchange="changeSoundVolume" aria-label="互动音效音量" /><text class="sound-volume-value">{{effectsVolume}}%</text></view>
      </view>
      <text class="sound-settings-note">{{route==='quiz'&&challenge&&challenge.status==='playing'?'答题计时照常进行':'设置会自动保存，下次继续沿用'}}</text>
      <view class="sound-settings-actions"><button id="sound-master" class="sound-mute-button {{pressedKey==='press-3'?'is-touching':''}}" bindtap="toggleSound" data-press-key="press-3" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">{{soundEnabled?'全部静音':'恢复声音'}}</button><button id="sound-settings-done" class="sound-done-button {{pressedKey==='press-4'?'is-touching':''}}" bindtap="closeSoundSettings" data-press-key="press-4" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">完成</button></view>
    </view>
  </view>
  <view class="theme-panel {{modal?'behind-modal':''}}">
    <view wx:if="{{route!=='levels' && route!=='home'}}" class="theme-heading"><image src="{{header}}" mode="aspectFit" /><text class="h1" style="{{titleArt.headingLabelStyle}}">{{skin.name}}</text></view>
    <view class="panel-content">
      <view wx:if="{{(route==='home' || route==='levels') && !error}}" class="activity-header">
        <image class="activity-header-scene" src="{{scene}}" mode="aspectFill" aria-hidden="true" /><view class="activity-header-wash" /><view class="activity-title-block"><view class="activity-title-content">
          <view wx:if="{{titleArt.visible}}" class="title-art-window" style="{{titleArt.frameStyle}}"><image class="activity-title-art" src="{{header}}" mode="scaleToFill" style="{{titleArt.imageStyle}}" aria-hidden="true" /></view><view class="home-title-label {{titleArt.plain?'plain-title':''}}" style="{{titleArt.labelStyle}}"><text class="activity-title">{{skin.name}}</text></view>
        </view></view>
        <view wx:if="{{homeDesign==='map'}}" class="home-direction-caption"><game-icon name="leaf" /><text>{{content.signature}}</text></view>
        <view wx:if="{{homeDesign==='guide'}}" class="home-paper-intro"><text class="home-paper-series">探索之旅</text><text>{{content.signature}}</text></view>
        <view class="activity-hud"><view class="activity-progress-row"><view class="activity-progress-copy"><text>闯关进度</text><text class="activity-progress-value">{{snapshot.progress.completed}}<text class="activity-progress-total"> / {{snapshot.progress.total}} 关</text></text></view><button class="activity-points {{pressedKey==='press-5'?'is-touching':''}}" data-action="go" data-route="points" bindtap="action" aria-label="查看我的{{snapshot.points}}学习积分" data-press-key="press-5" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="points" /><text>{{snapshot.points}} 积分</text><game-icon name="next" /></button></view>
        <view wx:if="{{skin.gameId!=='culture'}}" class="activity-progress-track"><view style="width:{{progressPercent}}%" /></view></view>
        <view wx:if="{{homeDesign!=='guide'}}" class="activity-links"><button class="activity-shortcut {{pressedKey==='press-6'?'is-touching':''}}" data-action="go" data-route="ranking" bindtap="action" data-press-key="press-6" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><view class="shortcut-mark"><game-icon name="rank" /></view><text>排行榜</text></button><button class="activity-shortcut {{pressedKey==='press-7'?'is-touching':''}}" data-action="go" data-route="certificate" bindtap="action" data-press-key="press-7" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><view class="shortcut-mark"><game-icon name="certificate" /></view><text>{{certificate?'我的证书':'通关证书'}}</text></button><button class="activity-shortcut {{pressedKey==='press-8'?'is-touching':''}}" data-action="go" data-route="profile" bindtap="action" data-press-key="press-8" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><view class="shortcut-mark"><game-icon name="book" /></view><text>我的学习</text></button></view>
      </view>
      <view wx:if="{{saveWarning && !loading && !error}}" class="persistence-note"><text class="persistence-copy">{{saveWarning}}</text><button wx:if="{{saveWarningCanRetry}}" class="persistence-retry {{pressedKey==='press-9'?'is-touching':''}}" data-action="{{configuration.mock?'retry-save':'retry'}}" bindtap="action" data-press-key="press-9" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">{{configuration.mock?'重试保存':'重新连接'}}</button></view>
      <view wx:if="{{route==='quiz' && challenge && !error}}" class="quiz-fixed">
        <view class="quiz-meta"><button class="icon-button {{pressedKey==='press-10'?'is-touching':''}}" data-action="exit" bindtap="action" aria-label="退出答题" data-press-key="press-10" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="close" /></button><text class="chapter-title">{{challenge.level.label}} · {{challenge.level.name}}</text><view class="timer {{challenge.remaining <= 8?'urgent':''}}"><game-icon name="clock" /><text class="b">{{challenge.remaining}}</text><text class="small">秒</text></view></view>
        <view class="quiz-progress"><view class="progress-caption"><text class="strong">{{questionNumber}}</text><text> / {{questionTotal}} 题</text><text class="small">单选题</text></view><view class="progress-track"><view class="i" style="width:{{questionProgress}}%" /></view></view>
      </view>
      <view class="panel-scroll-frame">
      <scroll-view class="panel-body" bindscroll="onMapScroll" scroll-y="{{route==='home'||route==='levels'?journey.canScroll:true}}" scroll-top="{{route==='home'||route==='levels'?mapScrollTop:0}}" scroll-into-view="{{homeDesign==='guide'?scrollInto:route==='home'||route==='levels'?'':scrollInto}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="panel-body-inner" id="page-content-top">
          <view wx:if="{{loading}}" class="state-block"><view class="loader" /><text class="h2">正在准备内容</text><text class="p">即将开启「{{skin.name}}」知识探索</text></view>
          <view wx:elif="{{error}}" class="state-block"><game-icon name="refresh" /><text class="h2">加载暂未完成</text><text class="p">{{error}}</text><game-button skin="{{skin.gameId}}" label="重新加载" kind="secondary" data-action="retry" bind:action="action" /></view>
          <block wx:elif="{{route==='home' || route==='levels'}}">
            <view wx:if="{{homeDesign==='guide' && levels.length}}" class="route-canvas chapter-board" style="height:{{journey.height}}px">
              <view class="chapter-tools">
                <button class="chapter-tool activity-shortcut {{pressedKey==='b-ranking'?'is-touching':''}}" data-action="go" data-route="ranking" bindtap="action" data-press-key="b-ranking" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><view class="chapter-tool-mark"><game-icon name="rank" /></view><text>排行榜</text><game-icon name="next" /></button>
                <button class="chapter-tool activity-shortcut {{pressedKey==='b-certificate'?'is-touching':''}}" data-action="go" data-route="certificate" bindtap="action" data-press-key="b-certificate" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><view class="chapter-tool-mark"><game-icon name="certificate" /></view><text>{{certificate?'我的证书':'通关证书'}}</text><game-icon name="next" /></button>
                <button class="chapter-tool activity-shortcut {{pressedKey==='b-profile'?'is-touching':''}}" data-action="go" data-route="profile" bindtap="action" data-press-key="b-profile" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><view class="chapter-tool-mark"><game-icon name="book" /></view><text>闯关记录</text><game-icon name="next" /></button>
              </view>
              <view class="chapter-directory-heading" style="top:{{journey.sectionTop}}px"><text>探索卡册</text><view class="chapter-directory-progress"><view class="chapter-progress-stamps" aria-hidden="true"><view wx:for="{{journey.nodes}}" wx:key="id" class="chapter-progress-stamp {{item.status}}"><game-icon wx:if="{{item.status==='completed'}}" name="check" /><view wx:elif="{{item.reached}}" class="chapter-progress-dot" /></view></view><text class="chapter-directory-count">{{snapshot.progress.completed}} / {{snapshot.progress.total}}</text></view></view>
              <view wx:for="{{journey.nodes}}" wx:key="id" id="{{item.anchorId}}" class="chapter-card {{item.featured?'chapter-active':''}} {{item.status}} {{item.showMascot?'has-actor':''}}" style="left:{{item.left}}px;top:{{item.top}}px;width:{{item.width}}px;height:{{item.height}}px">
                <button class="chapter-open {{pressedKey==='b-level-'+item.id?'is-touching':''}}" data-action="level" data-id="{{item.id}}" bindtap="action" data-press-key="b-level-{{item.id}}" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100" aria-label="{{item.label}}，{{item.name}}，{{item.statusText}}">
                  <view class="chapter-art-window" aria-hidden="true">
                    <image class="chapter-art-image" src="{{scene}}" mode="scaleToFill" style="height:{{item.artHeight}}px;top:{{item.artOffset}}px" />
                    <view wx:if="{{!item.showMascot}}" class="chapter-mystery"><text>?</text><view class="chapter-seal"><game-icon name="lock" /></view></view>
                    <view wx:elif="{{item.status==='completed'}}" class="chapter-complete-stamp"><game-icon name="check" /><text>通关</text></view>
                    <view wx:else class="chapter-status-mark"><game-icon white="{{true}}" name="{{item.status==='today-locked'?'clock':'next'}}" /><text>{{item.status==='today-locked'?'今日锁定':item.resumable?'继续闯关':'当前关卡'}}</text></view>
                  </view>
                  <text class="chapter-sequence">{{item.label}}</text>
                  <view class="chapter-card-copy">
                    <text class="chapter-card-title">{{item.name}}</text>
                    <text class="chapter-card-state">{{item.status==='locked'?'完成上一关解锁':item.status==='completed'?'已通关 · 可重玩':item.status==='today-locked'?'今日锁定 · 明日再来':item.resumable?'继续本关挑战':'当前关卡 · 开启挑战'}}</text>
                  </view>
                  <view class="chapter-card-reward"><game-icon name="points" /><text>{{item.status==='completed'?'已获':'首通'}} +{{item.status==='completed'?item.earnedPoints:item.points}} 积分</text></view>
                </button>
                <button wx:if="{{item.showMascot}}" class="chapter-mascot" data-id="{{item.id}}" bindtap="mascotTap" hover-class="mascot-pressed" hover-start-time="0" hover-stay-time="90" aria-label="和{{item.label}}的智小谷互动"><mascot-actor pose="{{item.pose}}" playing="{{motion.playingId===item.id}}" responding="{{motion.respondingId===item.id}}" cycle="{{motion.sequence}}" /></button><view wx:if="{{motion.respondingId===item.id}}" class="chapter-cheer" aria-hidden="true">一起出发！</view>
              </view>
            </view>
            <view wx:elif="{{levels.length}}" class="route-canvas" style="height:{{journey.height}}px;background-color:{{journey.ground}}">
              <image wx:for="{{journey.tiles}}" wx:key="id" class="route-scene" src="{{item.src}}" mode="aspectFit" style="height:{{item.height}}px;bottom:{{item.bottom}}px" />
              <block wx:for="{{journey.nodes}}" wx:key="id">
                <view class="route-anchor" id="{{item.anchorId}}" style="top:{{item.anchorTop}}px" />
                <view class="route-stop {{item.side}} {{item.status}} {{item.reached?'is-reached':''}} {{motion.respondingId===item.id?'is-responding':''}} response-phase-{{motion.sequence%2}}" style="left:{{item.left}};bottom:{{item.bottom}}px">
                  <button class="route-node {{pressedKey==='press-11'+'-'+item.id?'is-touching':''}}" data-action="level" data-id="{{item.id}}" bindtap="action" aria-label="{{item.label}}，{{item.name}}，{{item.statusText}}" data-press-key="press-11-{{item.id}}" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">
                    <view wx:if="{{item.reached}}" class="route-halo" />
                    <image class="route-base" src="{{item.nodeImage}}" mode="aspectFit" />
                    <text class="route-number">{{item.number}}</text>
                    <view wx:if="{{item.status==='completed'}}" class="route-node-badge done"><game-icon name="check" white="{{true}}" /></view>
                    <view wx:if="{{item.status==='locked' || item.status==='today-locked'}}" class="route-node-badge"><game-icon name="{{item.status==='today-locked'?'clock':'lock'}}" /></view>
                  </button>
                  <button wx:if="{{item.showMascot}}" class="chapter-mascot" data-id="{{item.id}}" bindtap="mascotTap" hover-class="mascot-pressed" hover-start-time="0" hover-stay-time="90" aria-label="和{{item.label}}的智小谷互动"><mascot-actor pose="{{item.pose}}" playing="{{motion.playingId===item.id}}" responding="{{motion.respondingId===item.id}}" cycle="{{motion.sequence}}" /><view class="mascot-touch-ring" aria-hidden="true" /></button>
                  <button class="route-caption {{pressedKey==='press-12'+'-'+item.id?'is-touching':''}}" data-action="level" data-id="{{item.id}}" bindtap="action" aria-label="{{item.label}}，{{item.name}}，{{item.statusText}}" data-press-key="press-12-{{item.id}}" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">
                    <view class="route-caption-tip" /><text class="route-caption-label">{{item.label}}</text><text class="route-caption-name">{{item.name}}</text>
                    <text class="route-caption-state">{{item.status==='completed'?'已完成 · 可重温':item.status==='current'?(item.resumable?'可继续本关':'当前关卡') : item.status==='today-locked'?'已到达 · 今日锁定':'完成上一关开启'}}</text>
                    <text class="route-caption-reward {{item.status==='completed'?'claimed':''}}">{{item.status==='completed'?'+'+item.earnedPoints+' 积分 · 已领取':'首通奖励 +'+item.points+' 积分'}}</text>
                  </button>
                </view>
              </block>
            </view>
            <view wx:else="" class="state-block"><game-icon name="book" /><text class="h2">内容准备中</text><text class="p">学习内容正在准备中，请稍后再来。</text></view>
          </block>
          <block wx:elif="{{route==='quiz' && challenge}}">
            <view class="quest-banner"><view class="quest-banner-copy"><text class="quest-eyebrow">{{chapterStyle.eyebrow}}</text><text class="quest-line">{{chapterStyle.line}}</text></view><view bindtap="inlineMascotTap" role="button" aria-label="轻点与智小谷互动" class="inline-actor quest-companion"><mascot-actor pose="{{pageActorPose}}" playing="{{motion.playingId===pageActorId}}" responding="{{motion.respondingId===pageActorId}}" cycle="{{motion.sequence}}" /></view></view>
            <view class="question-card white-card"><view class="question-corner" /><view class="question-kicker"><text class="question-tag">{{challenge.level.label}}</text><text>选出你心中的答案</text></view><text class="question-title">{{challenge.question.title}}</text><view wx:if="{{media}}" class="question-media"><view wx:if="{{mediaFailed}}" class="media-recovery"><text>{{media.required?'本题包含必要媒体，请重试加载':'媒体暂未加载，可重试或依据题干作答'}}</text><button data-action="retry-media" bindtap="action" class="{{pressedKey==='press-13'?'is-touching':''}}" data-press-key="press-13" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">重新加载</button><text>答题计时继续</text></view><video wx:elif="{{media.type==='video' && media.videoSrc}}" id="question-video" src="{{media.videoSrc}}" controls="{{true}}" show-center-play-btn="{{true}}" enable-play-gesture="{{true}}" bindloadedmetadata="mediaReady" bindtimeupdate="mediaProgress" binderror="mediaError" /><image wx:else="" src="{{media.src}}" mode="aspectFit" bindload="mediaLoaded" binderror="mediaError" /><text class="media-caption">{{media.alt}}</text></view></view>
            <view class="options"><button wx:for="{{options}}" wx:key="index" class="option {{item.selected?'selected':''}} {{item.correct?'correct':''}} {{pressedKey==='press-14'+'-'+(item.id || item.index || index)?'is-touching':''}}" disabled="{{challenge.status!=='playing' || busy}}" data-action="option" data-index="{{item.index}}" bindtap="action" aria-label="选项{{item.letter}}，{{item.text}}，{{item.selected?'已选择':'未选择'}}" data-press-key="press-14-{{item.id || item.index || index}}" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><text class="letter">{{item.letter}}</text><text class="option-text">{{item.text}}</text><view class="option-status"><game-icon wx:if="{{item.correct}}" name="check" white="{{true}}" /><view wx:elif="{{item.selected}}" class="dot" /></view></button></view>
            <view wx:if="{{challenge.status==='correct'}}" id="answer-feedback" class="answer-feedback"><view class="h3"><game-icon name="check" /><text>{{content.correct}}</text></view><text class="p">{{challenge.feedback.explanation}}</text><text class="small">知识来源：{{challenge.feedback.sourceTitle}}</text></view>
          </block>
          <block wx:elif="{{route==='result' && result}}">
            <view class="section-bar"><button class="icon-button {{pressedKey==='press-15'?'is-touching':''}}" data-action="go" data-route="levels" bindtap="action" aria-label="返回关卡" data-press-key="press-15" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="back" /></button><text class="bar-label">本次学习成果</text><view class="bar-spacer" /></view>
            <view class="completion-hero"><view bindtap="inlineMascotTap" role="button" aria-label="轻点与智小谷互动" class="inline-actor result-companion"><mascot-actor pose="{{pageActorPose}}" playing="{{motion.playingId===pageActorId}}" responding="{{motion.respondingId===pageActorId}}" cycle="{{motion.sequence}}" /></view><view class="completion-icon"><game-icon name="check" /></view><text class="eyebrow">{{challenge.level.label}} · {{challenge.level.name}}</text><text class="h2">本关学习已完成</text><text class="p">{{result.firstCompletion?content.result:content.replay}}</text></view>
            <view class="stat-pair"><view class="white-card stat"><text class="strong">{{result.accuracy}}<text class="small">%</text></text><text class="label">首答正确率</text></view><view class="white-card stat"><text class="strong">+{{result.points}}</text><text class="label">本次获得积分</text></view></view><view class="summary-line white-card"><view class="summary-label"><game-icon name="points" />四主题累计积分</view><text class="strong">{{snapshot.points}}</text></view><text class="micro-copy">{{result.firstCompletion?'首通积分已计入；重温不重复计分。':'本关首通积分已领取；重温不重复计分。'}}</text>
            <button wx:if="{{certificate}}" class="certificate-notice white-card {{pressedKey==='press-16'?'is-touching':''}}" data-action="go" data-route="certificate" bindtap="action" data-press-key="press-16" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="certificate" /><view class="notice-copy"><text class="strong">主题学习证书已获得</text><text class="small">查看「{{certificate.name}}」证书</text></view><game-icon name="next" /></button>
          </block>
          <block wx:elif="{{route==='profile'}}">
            <view class="section-bar"><button class="icon-button {{pressedKey==='press-17'?'is-touching':''}}" data-action="go" data-route="home" bindtap="action" aria-label="返回首页" data-press-key="press-17" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="back" /></button><text class="bar-label">我的学习</text><view class="bar-spacer" /></view>
            <view class="profile-card white-card"><view bindtap="inlineMascotTap" role="button" aria-label="轻点与智小谷互动" class="inline-actor profile-avatar"><mascot-actor pose="{{pageActorPose}}" playing="{{motion.playingId===pageActorId}}" responding="{{motion.respondingId===pageActorId}}" cycle="{{motion.sequence}}" /></view><text class="h2">{{profile.nickname}}</text><text class="profile-badge">{{profile.badge}}</text><text class="p">{{content.profile}}</text></view>
            <view class="profile-stats"><button data-action="go" data-route="levels" bindtap="action" class="{{pressedKey==='press-18'?'is-touching':''}}" data-press-key="press-18" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><text class="strong">{{snapshot.progress.completed}} / {{snapshot.progress.total}}</text><text>已完成关卡</text></button><button data-action="go" data-route="points" bindtap="action" class="{{pressedKey==='press-19'?'is-touching':''}}" data-press-key="press-19" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><text class="strong">{{snapshot.points}}</text><text>我的学习积分</text></button></view>
            <button class="profile-link white-card {{pressedKey==='press-20'?'is-touching':''}}" data-action="go" data-route="certificate" bindtap="action" data-press-key="press-20" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="certificate" /><view><text class="strong">我的学习证书</text><text class="small">{{certificate?'已获得主题学习证书':'查看主题证书与四主题总证书'}}</text></view><game-icon name="next" /></button>
            <view class="brand-signature"><image src="/assets/brand/logo.png" mode="aspectFit" /><text>{{content.signature}}</text></view>
          </block>
          <block wx:elif="{{route==='points'}}">
            <view class="section-bar"><button class="icon-button {{pressedKey==='press-21'?'is-touching':''}}" data-action="go" data-route="home" bindtap="action" aria-label="返回首页" data-press-key="press-21" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="back" /></button><text class="bar-label">我的学习积分</text><view class="bar-spacer" /></view>
            <view class="points-user"><view bindtap="inlineMascotTap" role="button" aria-label="轻点与智小谷互动" class="inline-actor points-avatar"><mascot-actor pose="{{pageActorPose}}" playing="{{motion.playingId===pageActorId}}" responding="{{motion.respondingId===pageActorId}}" cycle="{{motion.sequence}}" /></view><view><text class="strong">{{profile.nickname}}</text><text class="small">{{profile.badge}} · 我的学习积分</text></view></view><view class="points-hero"><game-icon name="points" /><text class="small">四主题累计积分</text><text class="strong">{{snapshot.points}}</text><text class="p">{{skin.name}} · 首通学习记录</text></view><text class="h2 section-title">积分明细</text><view wx:if="{{ledger.length}}" class="record-list white-card"><view wx:for="{{ledger}}" wx:key="id" class="record-row"><view class="record-copy"><text class="strong">{{item.label}} · 首次完成</text><text class="small">{{item.date}}</text></view><text class="b">+{{item.points}}</text></view></view><view wx:else="" class="state-block"><game-icon name="book" /><text class="h2">还没有积分记录</text><text class="p">{{content.pointsEmpty}}</text><game-button skin="{{skin.gameId}}" label="去闯关" kind="secondary" data-action="go" data-route="levels" bind:action="action" /></view><text class="micro-copy">积分与四主题学习记录同步；重温不重复计分。</text>
          </block>
          <block wx:elif="{{route==='ranking'}}">
            <view class="section-bar"><button class="icon-button {{pressedKey==='press-22'?'is-touching':''}}" data-action="go" data-route="home" bindtap="action" aria-label="返回首页" data-press-key="press-22" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="back" /></button><text class="bar-label">学习成果排行</text><view class="bar-spacer" /></view>
            <view class="segmented"><button class="tab {{period==='daily'?'active':''}} {{pressedKey==='press-23'?'is-touching':''}}" data-action="period" data-period="daily" bindtap="action" data-press-key="press-23" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">每日榜</button><button class="tab {{period==='total'?'active':''}} {{pressedKey==='press-24'?'is-touching':''}}" data-action="period" data-period="total" bindtap="action" data-press-key="press-24" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">总榜</button></view><text class="ranking-rule">按完成关卡、首答正确率及完成时间排序
看看大家的学习收获</text>
            <view wx:if="{{ranking.rows.length}}" class="rank-table white-card"><view class="rank-table-head"><text>名次 / 昵称</text><text>学习积分</text></view><view wx:for="{{ranking.rows}}" wx:key="rank" class="rank-row {{item.me?'is-me':''}}"><text class="rank-number">{{item.rank}}</text><text class="avatar">{{item.initial}}</text><view class="rank-name"><text class="strong">{{item.name}}{{item.me?' · 我':''}}</text><text class="small">{{item.completed}}关 · 首答正确率{{item.accuracy}}%</text></view><text class="rank-score">{{item.points}}</text></view></view><view wx:else="" class="state-block"><game-icon name="rank" /><text class="h2">榜单尚无记录</text><text class="p">完成学习后，记录会出现在四主题榜单。</text></view><view class="my-rank white-card"><text>我的{{period==='daily'?'今日':'总'}}排名 <text class="strong">{{ranking.me.rank?'第 '+ranking.me.rank+' 名':'暂未上榜'}}</text></text><text class="b">{{ranking.me.points}} 分</text></view>
          </block>
          <block wx:elif="{{route==='certificate'}}">
            <view class="section-bar"><button class="icon-button {{pressedKey==='press-25'?'is-touching':''}}" data-action="go" data-route="home" bindtap="action" aria-label="返回首页" data-press-key="press-25" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="back" /></button><text class="bar-label">我的学习证书</text><view class="bar-spacer" /></view>
            <view wx:if="{{snapshot.globalProgress}}" class="series-progress white-card"><text class="strong">四主题总进度 {{snapshot.globalProgress.completed}} / {{snapshot.globalProgress.total}} 关</text><text class="small">完成四个主题的全部关卡，自动领取总证书</text></view><view wx:if="{{certificates.length>1}}" class="certificate-switch"><button wx:for="{{certificates}}" wx:key="id" data-action="choose-certificate" data-id="{{item.id}}" bindtap="action" class="{{certificate.id===item.id?'active':''}} {{pressedKey==='press-26'+'-'+(item.id || item.index || index)?'is-touching':''}}" data-press-key="press-26-{{item.id || item.index || index}}" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">{{item.scope==='all'?'总证书':item.name}}</button></view><block wx:if="{{certificate}}"><view class="certificate-paper" aria-label="{{certificate.userName}}的{{certificate.name}}荣誉证书"><image wx:if="{{certificateImage}}" class="certificate-preview" bindtap="previewCertificate" binderror="certificateImageFailed" src="{{certificateImage}}" mode="widthFix" show-menu-by-longpress="{{true}}" aria-label="荣誉证书，{{certificate.userName}}，{{certificate.name}}，{{certificate.date}}" /><view wx:else class="certificate-placeholder"><text class="certificate-placeholder-heading">荣誉证书</text><text class="p">{{certificateImageError?'证书图片暂未生成，请重试。':'正在生成你的荣誉证书…'}}</text><game-button wx:if="{{certificateImageError}}" id="certificate-retry" skin="{{skin.gameId}}" kind="secondary" label="重新生成证书" data-action="retry-certificate" bind:action="action" /></view></view><text class="micro-copy certificate-save-note">轻点查看完整证书，保存珍藏学习收获。</text></block><view wx:else="" class="state-block"><game-icon name="certificate" /><text class="h2">证书正等待你点亮</text><text class="p">完成「{{skin.name}}」的全部关卡，
即可获得主题学习证书。</text><game-button skin="{{skin.gameId}}" label="继续闯关" kind="secondary" data-action="go" data-route="levels" bind:action="action" /></view>
          </block>
        </view>
      </scroll-view>
      <block wx:if="{{(route==='home'||route==='levels') && journey.canScroll && !loading && !error && !saveWarning}}">
        <view wx:if="{{mapFadeTop}}" class="map-edge-fade map-edge-top" aria-hidden="true" />
        <view wx:if="{{mapFadeBottom}}" class="map-edge-fade map-edge-bottom" aria-hidden="true" />
        <view wx:if="{{mapHintVisible && !modal}}" class="map-scroll-hint"><text>上下滑动查看关卡</text></view>
      </block>
      </view>
      <view wx:if="{{footerPrimary && !error && !loading}}" class="panel-footer"><text wx:if="{{skin.gameId!=='culture' && (route==='home' || route==='levels') && levels.length}}" class="activity-prize-note">{{certificate?'已获得「'+certificate.name+'」证书':'完成全部 '+snapshot.progress.total+' 关，获得主题学习证书'}}</text><game-button id="footer-primary" appearance="{{homeDesign==='guide' && (route==='home' || route==='levels')?'paper':'current'}}" emphasis="{{route==='home' || route==='levels'}}" skin="{{skin.gameId}}" kind="primary" label="{{footerPrimary}}" disabled="{{footerDisabled}}" loading="{{busy}}" data-action="{{footerAction}}" data-id="{{footerId}}" data-route="{{footerRoute}}" bind:action="action" /><game-button id="footer-secondary" wx:if="{{footerSecondary}}" skin="{{skin.gameId}}" kind="secondary" label="{{footerSecondary}}" data-action="{{secondaryAction}}" data-route="{{secondaryRoute}}" bind:action="action" /></view>
    </view>
  </view>
  <view wx:if="{{modal}}" class="modal-mask" catchtap="blockTap"><view class="theme-modal modal-{{modal}}"><view class="modal-decoration"><image src="{{header}}" mode="aspectFit" /><text class="modal-game-name" style="{{titleArt.modalLabelStyle}}">{{skin.name}}</text></view><view class="modal-topbar"><text class="h2">{{modalTitle}}</text><button class="modal-close icon-button {{pressedKey==='press-27'?'is-touching':''}}" data-action="close-modal" bindtap="action" aria-label="关闭弹窗" data-press-key="press-27" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100"><game-icon name="close" /></button></view><scroll-view class="modal-inner" scroll-y="{{true}}">
    <block wx:if="{{modal==='rules'}}"><view class="chapter-welcome"><view bindtap="inlineMascotTap" role="button" aria-label="轻点智小谷，打个招呼" class="modal-actor"><mascot-actor id="modal-rules-actor" pose="{{rulePose}}" playing="{{motion.playingId==='modal-rules'}}" responding="{{motion.respondingId==='modal-rules'}}" cycle="{{motion.sequence}}" /></view><view><text class="chapter-welcome-label">{{ruleLevel.label}} · {{chapterStyle.eyebrow}}</text><text class="chapter-welcome-name">{{ruleLevel.name}}</text><text class="chapter-welcome-copy">{{chapterStyle.line}}</text></view></view><view class="rule-grid"><view class="rule-cell"><text class="b">{{ruleLevel.questionCount}}</text>道题</view><view class="rule-cell"><text class="b">{{configuration.timerSeconds}}</text>秒 / 题</view><view class="rule-cell"><text class="b">{{configuration.reviveLimit}}</text>次复活</view></view><text class="p">答对后阅读解析，继续下一题。答错或超时可分享复活；次数用尽后，本关锁定至次日。</text><text class="micro-copy">首次完成 +{{ruleLevel.points}} 分；重温不重复计分。</text></block>
    <block wx:elif="{{modal==='revive'}}"><view bindtap="inlineMascotTap" role="button" aria-label="轻点智小谷，查看鼓励动作" class="modal-actor revive-companion"><mascot-actor id="modal-revive-actor" pose="{{modalActorPose}}" playing="{{motion.playingId==='modal-revive'}}" responding="{{motion.respondingId==='modal-revive'}}" cycle="{{motion.sequence}}" /></view><text class="p modal-lead">{{challenge.feedback.reason==='timeout'?'本题暂未完成':'本次回答未通过'}}</text><text class="p">还有 {{challenge.reviveRemaining}} 次复活机会。
复活后继续回答本题。</text><text class="micro-copy">本阶段不提前展示正确答案。</text></block>
    <block wx:elif="{{modal==='share'}}"><view class="share-preview white-card"><view class="share-cover-frame"><image wx:if="{{sharePreviewImage}}" class="share-cover-image" src="{{sharePreviewImage}}" mode="aspectFit" /><view wx:else class="share-cover-fallback"><image class="share-cover-landscape" src="{{scene}}" mode="widthFix" /><text class="share-cover-theme">{{skin.name}}</text><image class="share-cover-character" src="{{shareCoverActor}}" mode="aspectFit" /></view></view><text class="strong">{{shareCopy.title}}</text><text class="p">{{shareCopy.text}}</text></view></block>
    <block wx:elif="{{modal==='locked'}}"><view bindtap="inlineMascotTap" role="button" class="modal-actor rest-companion" aria-label="智小谷陪你稍作休息"><mascot-actor id="modal-locked-actor" pose="{{modalActorPose}}" playing="{{motion.playingId==='modal-locked'}}" responding="{{motion.respondingId==='modal-locked'}}" cycle="{{motion.sequence}}" /></view><text class="p modal-lead">本关今日已锁定</text><text class="p">复活次数已用完。
北京时间次日 00:00 后可重新参与。</text><text class="micro-copy">仅锁定当前关卡，已获得积分保留。</text></block>
    <block wx:elif="{{modal==='exit'}}"><text class="p">本次答题进度会自动保存。
离开期间，倒计时仍会继续。</text><text class="micro-copy">再次进入本关可恢复进度；超时按未通过处理。</text></block>
    <block wx:elif="{{modal==='certificate-share'}}"><view class="share-preview white-card"><view class="share-cover-frame"><image wx:if="{{certificateShareImage}}" class="share-cover-image" src="{{certificateShareImage}}" mode="aspectFit" /><view wx:else class="share-cover-fallback"><image class="share-cover-landscape" src="{{scene}}" mode="widthFix" /><text class="share-cover-theme">{{skin.name}}</text><image class="share-cover-character" src="{{shareCoverActor}}" mode="aspectFit" /></view></view><text class="strong">{{skin.name}} · 学习完成</text><text class="p">已获得「{{certificate.name}}」学习称号</text></view><text class="p">与朋友分享你的学习收获。</text></block>
    <block wx:elif="{{modal==='video'}}"><text class="p">视频暂时无法播放，请返回题目重试。</text></block>
    <block wx:elif="{{modal==='save-failure'}}"><text class="p">证书保存暂未完成，请检查相册权限后重试。</text></block>
    </scroll-view><view class="modal-actions"><game-button id="modal-primary" skin="{{skin.gameId}}" label="{{modalPrimary}}" data-action="{{modalAction}}" bind:action="action" /><button wx:if="{{modal==='certificate-share'}}" class="text-link {{pressedKey==='press-28'?'is-touching':''}}" open-type="share" bindtap="pressTap" data-press-key="press-28" bindtouchstart="pressStart" bindtouchmove="pressMove" bindtouchend="pressEnd" bindtouchcancel="cancelPress" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100">打开微信分享</button><game-button id="modal-secondary" wx:if="{{modalSecondary}}" skin="{{skin.gameId}}" kind="secondary" label="{{modalSecondary}}" data-action="{{modalSecondaryAction}}" bind:action="action" /></view></view></view>
  <picker wx:if="{{review && reviewControls}}" class="review-tools" range="{{scenarioLabels}}" value="{{scenarioIndex}}" bindchange="pickScenario">评审场景 ▾</picker>
  <canvas type="2d" id="certificate-canvas" class="certificate-canvas" /><canvas type="2d" id="share-cover-canvas" class="share-cover-canvas" />
</view>
