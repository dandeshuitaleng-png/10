:host {display:block;} .state {padding:44px 20px;text-align:center;color:#66736C;line-height:1.8;display:flex;flex-direction:column;align-items:center;gap:12px;font-size:16px;} .title {font-size:20px;color:#333C39;} button {background:#315C4C;color:white;font-size:16px;margin-top:12px;min-height:48px;border-radius:8px;} .loader {height:24px;width:24px;border:2px solid #DEDCCD;border-top-color:#315C4C;border-radius:50%;animation:rotate 1s linear infinite;} @keyframes rotate {to {transform:rotate(360deg);}}
