:host { display: block; }
.button { display:flex; justify-content:center; align-items:center; box-sizing:border-box; width:100%; min-height:52px; padding:12px 20px; margin:0; border-radius:10px; font-size:17px; font-weight:500; line-height:1.5; background:#315C4C; color:#fff; border:1px solid transparent; transition:opacity .18s; }
.button::after { border:0; }
.secondary { color:#315C4C; background:transparent; border-color:#315C4C; }
.quiet { color:#315C4C; background:#EDF0E9; }
.button[disabled] { background:#E2E4DB; color:#5C685F; border-color:transparent; }
.pressed { opacity:.8; }
.button.button { width:100%; margin:0; }

.button.button{min-height:54px;border:1px solid #B39A70;border-radius:5px;background:#315C4C;color:#FFFDF7;font-size:18px;letter-spacing:2px;box-shadow:inset 0 0 0 3px #315C4C,inset 0 0 0 4px #B39A7066;}.button.secondary{background:#F7F3E9;color:#315C4C;box-shadow:none;}.button.quiet{background:#E4EAD9;color:#315C4C;box-shadow:none;}.button[disabled]{background:#DADDD1;color:#5C685F;box-shadow:none;border-color:#BBBCAF;}
