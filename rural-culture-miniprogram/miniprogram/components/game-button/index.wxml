<button class="game-button appearance-{{appearance}} {{kind}} skin-{{skin}} {{emphasis?'is-home-action':''}} {{touching?'is-touching':''}}" disabled="{{disabled || loading}}" loading="{{loading}}" bindtap="press" hover-class="native-pressed" hover-start-time="0" hover-stay-time="100" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"><view class="button-inset" /><view wx:if="{{emphasis}}" class="action-emblem" aria-hidden="true"><image src="{{skin==='red'||skin==='culture'?'/assets/icons/book-white.png':'/assets/icons/book.png'}}" mode="aspectFit" /></view><text class="button-label">{{label}}</text><view wx:if="{{emphasis}}" class="action-forward" aria-hidden="true"><image src="{{skin==='red'||skin==='culture'?'/assets/icons/next-white.png':'/assets/icons/next.png'}}" mode="aspectFit" /></view></button>
