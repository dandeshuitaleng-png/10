page { background:#F7F3E9;color:#333C39;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:17px;line-height:1.65; }
view,text,button,image {box-sizing:border-box;}
button {font-family:inherit;} button::after {border:0;}
.page {max-width:960px;margin:0 auto;padding:20px 24px 40px;min-height:100vh;}
.topbar {display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;margin-bottom:18px;}
.brand {font-size:14px;color:#315C4C;font-weight:500;letter-spacing:1px;}
.brand-mark {display:inline-flex;align-items:center;justify-content:center;background:#315C4C;color:#F7F3E9;border-radius:3px;font-family:serif;width:26px;height:28px;margin-right:9px;letter-spacing:0;}
.back {background:none;padding:10px 0;margin:0;color:#315C4C;font-size:15px;line-height:1.6;min-width:70px;text-align:left;}
.tiny-label,.eyebrow {font-size:13px;font-weight:500;letter-spacing:2px;color:#66736C;}
.eyebrow {color:#315C4C;margin-bottom:9px;}
.display {font-family:"Songti SC","STSong",serif;font-size:36px;font-weight:600;line-height:1.45;letter-spacing:3px;}
.heading {font-family:"Songti SC","STSong",serif;font-size:28px;font-weight:600;line-height:1.5;letter-spacing:1px;}
.h2 {font-size:21px;font-weight:600;line-height:1.5;}
.muted {color:#66736C;font-size:15px;line-height:1.7;}
.body {font-size:17px;line-height:1.75;}
.small {font-size:14px;line-height:1.65;color:#66736C;}
.intro {margin:12px 0 24px;color:#66736C;font-size:17px;line-height:1.7;}
.section-head {display:flex;align-items:center;justify-content:space-between;gap:12px;margin:26px 0 16px;}
.link {background:none;color:#315C4C;padding:10px 0;font-size:15px;line-height:1.5;margin:0;text-align:right;}
.panel {background:#FFFDF7;border:1px solid #DEDCCD;border-radius:14px;padding:22px;}
.row {display:flex;align-items:center;justify-content:space-between;gap:12px;}
.stack {display:flex;flex-direction:column;gap:12px;}
.button-stack {display:flex;flex-direction:column;gap:12px;margin-top:24px;}
.badge {display:inline-flex;align-items:center;font-size:13px;color:#315C4C;background:#EDF0E9;padding:4px 10px;border-radius:5px;white-space:nowrap;}
.divider {height:1px;background:#DEDCCD;margin:20px 0;}
.footer-note {font-size:13px;color:#66736C;text-align:center;line-height:1.7;margin-top:28px;}
.art {width:100%;display:block;}
.stat-number {font-size:30px;font-weight:500;line-height:1.3;color:#315C4C;font-variant-numeric:tabular-nums;}
.stats {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;text-align:center;padding:8px 0;}
.note {color:#66736C;font-size:14px;line-height:1.7;background:#ECEEE5;padding:14px 16px;border-radius:8px;margin:20px 0;}
.fade {animation:appear .2s ease-out;} @keyframes appear {from{opacity:.4;transform:translateY(3px);}to{opacity:1;transform:translateY(0);}}
@media (max-width:350px){.page{padding-left:20px;padding-right:20px;}.display{font-size:32px;}.panel{padding:18px;}.stats{gap:8px;}.small{font-size:14px;}}
@media (min-width:700px){.page{padding:28px 40px 48px;}.display{font-size:44px;}}
@media (prefers-reduced-motion:reduce){.fade{animation:none;} }
.back.back,.link.link {width:auto;margin:0;}

.page{padding-left:20px;padding-right:20px;}.panel{border-radius:5px;border-color:#C9B99C;background:#FCF7EA;}.heading{font-family:'Songti SC',serif;letter-spacing:2px;}.topbar{border-bottom:1px solid #D7CBAF;padding-bottom:12px;margin-bottom:20px;}.badge{border-radius:3px;}.note{border-radius:3px;background:#EEE7D6;}.certificate-paper{box-shadow:0 5px 20px #61583315;}.my-rank{border-radius:4px;}.tabs,.certificate-tabs{border-radius:4px;background:#E4DECB;}.footer-note{letter-spacing:1px;}@media(min-width:700px){.page{padding-left:40px;padding-right:40px;}}
