.result-page{max-width:680px;}.result-hero{text-align:center;padding-top:25px;}.completion-mark{width:64px;height:64px;border:1px solid #B39A70;border-radius:50%;margin:0 auto 28px;color:#315C4C;font-size:30px;line-height:62px;background:#EAEEDD;}.result-panel{text-align:center;padding:28px 24px;}.accuracy-value{font-size:48px;line-height:1.4;color:#315C4C;font-weight:500;}.accuracy-value text{font-size:22px;margin-left:4px;}.result-stats{display:grid;grid-template-columns:1fr 1fr;gap:20px;}.result-stats>view+view{border-left:1px solid #DEDCCD;}.result-stats .small{margin-top:6px;}

.result-scene{width:100%;height:190px;display:block;margin-bottom:24px;border:1px solid #B39A70;}.result-hero{padding-top:4px;}.completion-mark{width:72px;height:72px;border:3px double #9A5147;border-radius:3px;background:transparent;color:#9A5147;font:22px/1.25 'Songti SC',serif;padding:6px 10px;transform:rotate(-5deg);margin:-52px auto 28px;position:relative;background:#F7F3E9;}.result-panel{border-color:#BAA781;border-radius:4px;box-shadow:0 5px 18px #625A3412;}.result-stats .stat-number{color:#886638;}.result-hero .heading{font-size:30px;}
