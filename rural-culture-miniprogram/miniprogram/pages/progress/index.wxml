<view class="page"><view class="topbar"><button class="back" bindtap="home">‹ 首页</button><text class="tiny-label">我的学习</text></view><view class="eyebrow">将收获，写进自己的读本</view><view class="heading">学习足迹</view><view class="intro">慢慢读，常常学。每一步都有意义。</view><page-state loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{summary && !loading && !error}}"><view class="panel"><view class="small">{{summary.user.name}}</view><view class="stats"><view><view class="stat-number">{{summary.completedCount}}</view><view class="small">已完成章节</view></view><view><view class="stat-number">{{summary.points}}</view><view class="small">学习积分</view></view><view><view class="stat-number">{{summary.certificateCount}}</view><view class="small">电子证书</view></view></view><view class="divider"></view><study-progress value="{{summary.progress}}" label="整体学习进度 {{summary.progress}}%"/></view><page-state empty="{{!summary.lastChapter}}" message="还没有学习记录，选一卷文化读本，从第一章开始。"/><view class="continue-card" wx:if="{{summary.lastChapter}}"><view class="small">最近探索</view><view class="h2">{{summary.lastChapter.themeName}} · {{summary.lastChapter.title}}</view></view><view class="button-stack"><ui-button class="action-button" label="{{summary.lastChapter ? '继续文化探索' : '开启第一次探索'}}" bind:action="continueStudy"/></view><view class="section-head"><text class="h2">我的文化读本</text><button class="link" bindtap="certificate">查看证书 →</button></view><button class="progress-item" wx:for="{{themes}}" wx:key="id" data-id="{{item.id}}" bindtap="enter"><view class="row"><text class="progress-title" style="color:{{item.color}}">{{item.name}}</text><text class="small">{{item.completedCount}} / {{item.totalChapters}} 章 →</text></view><study-progress value="{{item.completedCount / item.totalChapters * 100}}" color="{{item.color}}"/></button></block><view class="footer-note">乡土有书香，学习有回响。</view></view>
