/* Purpose-built 5:4 share cover; landscape, title and character stay inside the frame. */
.share-preview.white-card{padding:8px;margin:8px 0 12px;border:1px solid var(--edge);border-radius:16px;text-align:left}
.share-cover-frame{position:relative;height:0;padding-bottom:80%;width:100%;border-radius:10px;overflow:hidden;background:var(--pale)}
.share-preview .share-cover-image,.share-cover-fallback{position:absolute;left:0;top:0;width:100%;height:100%;border-radius:0}
.share-preview .share-cover-landscape{position:absolute;left:0;top:0;width:100%;height:auto;border-radius:0}
.share-cover-theme{position:absolute;left:16px;top:16px;font-size:22px;font-weight:700;line-height:32px;color:var(--ink)}
.share-preview .share-cover-character{position:absolute;right:12px;bottom:8px;width:34%;height:50%;border-radius:0}
.share-preview .strong{padding:0 8px;margin:12px 0 4px;font-size:16px;line-height:24px}
.share-preview .p{padding:0 8px 8px;margin:0;font-size:13px!important;line-height:21px}
.share-cover-canvas{position:fixed;left:-3000px;top:0;width:600px;height:480px;pointer-events:none}

