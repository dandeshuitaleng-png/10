.activity-progress-track{height:7px;border:1px solid #8a652e55;background:#b99a6470;border-radius:6px;box-shadow:inset 0 2px 3px #60451940,0 1px 0 #fff;overflow:hidden}.activity-progress-track>view{background:linear-gradient(180deg,#fbd878,#d3972d);box-shadow:inset 0 1px 0 #fff9;border-radius:5px}.skin-red .activity-progress-track>view{background:linear-gradient(#f8bc6f,#d87539)}.skin-ecology .activity-progress-track>view{background:linear-gradient(#bedf7c,#639b49)}
.activity-links{position:relative;z-index:1;margin-top:5px;gap:9px}.activity-links>button{border-radius:10px;color:var(--route-ink);font-size:11px;gap:4px;text-shadow:0 1px 0 #fff9}.activity-links game-icon{width:22px;height:22px;padding:3px;background:linear-gradient(#fffdf2,var(--material-paper));border:1px solid var(--material-edge);border-radius:50%;box-shadow:0 2px 0 var(--material-base),inset 0 1px 0 #fff}
.game-device.activity-page .route-caption{border:1px solid var(--material-edge);background:linear-gradient(155deg,#fffefa 0%,#fff8e7 55%,var(--material-paper) 100%);box-shadow:0 4px 0 var(--material-base),0 7px 10px var(--material-shadow),inset 0 1px 0 #fff,inset 0 -2px 0 #fff8;border-radius:12px}.game-device.activity-page .route-stop.current .route-caption{border:2px solid #dea42d;background:linear-gradient(150deg,#fffefa,#fff1c2);box-shadow:0 4px 0 #b27a25,0 0 0 3px #fff3ae88,0 9px 14px #98631d35,inset 0 1px 0 #fff}.game-device.activity-page .route-stop.completed .route-caption{background:linear-gradient(145deg,#fffff5,#f0f3dc);border-color:#9cb179;box-shadow:0 4px 0 #889b63,0 7px 10px #5c73312b,inset 0 1px 0 #fff}.game-device.activity-page .route-stop.locked .route-caption{background:linear-gradient(150deg,#fffdf5,#f2ead8);color:#686963}.game-device.activity-page .route-caption-name{text-shadow:0 1px 0 #fff}
.game-device.activity-page .route-caption-reward{display:inline-block;padding:0 5px;margin-top:3px;line-height:14px;font-size:10px;border-radius:4px;background:linear-gradient(#ffe7a4,#f2c96a);box-shadow:0 1px 0 #c2994b,inset 0 1px 0 #fff8;color:#805010}.game-device.activity-page .route-caption-reward.claimed{background:linear-gradient(#ebf4d2,#d9e8b6);box-shadow:0 1px 0 #a4b979,inset 0 1px 0 #fff;color:#4f6a2c}.game-device.activity-page .route-caption-tip{background:#fff8e7;border-color:var(--material-edge)}
.game-device.activity-page .panel-footer{position:relative;z-index:2;background:linear-gradient(180deg,#fff7e7,var(--material-paper));border-top:1px solid var(--material-edge);box-shadow:0 -3px 0 #fff8,0 -8px 16px var(--material-shadow);padding-top:7px}.game-device.activity-page .activity-prize-note{color:var(--route-ink);opacity:.9;text-shadow:0 1px 0 #fff}
