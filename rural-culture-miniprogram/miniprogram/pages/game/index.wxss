.game-device.activity-page.landscape-home .activity-prize-note{display:none}


.game-device.activity-page.landscape-home .activity-header{padding:0 16px;background:var(--route-paper);border:0;box-shadow:none}
.game-device.activity-page.landscape-home .activity-header-scene,.game-device.activity-page.landscape-home .activity-header-wash,.game-device.activity-page.landscape-home .activity-description,.game-device.activity-page.landscape-home .activity-progress-track{display:none}
.game-device.activity-page.landscape-home .route-scene{object-fit:contain}
.game-device.activity-page.landscape-home .route-guide{bottom:42px}
.game-device.activity-page.skin-red.landscape-home .route-caption{color:#68432f}
.game-device.activity-page.skin-industry.landscape-home .route-caption{color:#645024}
.game-device.activity-page.skin-ecology.landscape-home .route-caption{color:#3c6149}
.game-device.activity-page.skin-ecology.landscape-home .route-stop.current .route-caption{border-color:#bed68b;background:#fbfff0;color:#36583d}
@media(max-width:350px){.game-device.activity-page.landscape-home .route-guide{width:48px;bottom:30px}.game-device.activity-page.landscape-home .route-guide image{width:48px;height:58px}.game-device.activity-page.landscape-home .route-guide text{min-width:52px;font-size:10px}}

@media(max-width:350px){.game-device.activity-page.landscape-home .route-stop.right .route-guide{left:calc(var(--map-node-w) + 8px)}}

/* 排行榜分段按钮：覆盖微信原生button的固有宽度，避免撑开网格列。 */
.game-device .segmented{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.game-device .segmented button.tab{width:100%;min-width:0;max-width:100%;margin:0;padding:0;box-sizing:border-box}

