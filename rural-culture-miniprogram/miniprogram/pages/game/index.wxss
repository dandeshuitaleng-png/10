/* Network content; homepage geometry remains unchanged. */
.series-progress{margin-bottom:16px;padding:16px}.series-progress text{display:block;margin:4px 0}.certificate-switch{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.certificate-switch button{margin:0;padding:8px 12px;font-size:12px;background:#fff;border:1px solid #d6d7cc;border-radius:12px;line-height:1.5}.certificate-switch button.active{border-color:var(--accent);color:var(--ink);font-weight:700}.media-recovery{min-height:140px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:16px;font-size:13px}.media-recovery button{padding:8px 18px;font-size:13px;line-height:1.5}.media-caption{display:block;padding:8px;font-size:11px;line-height:1.5;color:#68838f}.question-media video{width:100%;height:200px}

