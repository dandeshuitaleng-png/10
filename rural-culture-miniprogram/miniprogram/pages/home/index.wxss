.home-page{padding-top:16px;}.home-hero{height:460px;position:relative;margin:0 -20px;overflow:hidden;}.hero-art{position:absolute;width:100%;height:100%;left:0;top:0;object-fit:cover;}.hero-title{position:absolute;inset:0 0 auto;padding:22px 20px 85px;text-align:center;background:linear-gradient(#F7F3E9 5%,rgba(247,243,233,.93) 36%,rgba(247,243,233,0));}.hero-title .display{font-size:48px;letter-spacing:7px;color:#264C40;text-shadow:0 2px 0 #fff6;}.hero-subtitle{font-size:14px;letter-spacing:2px;margin-top:8px;color:#526453;}.hero-caption{position:absolute;right:22px;bottom:34px;}.seal{font:16px serif;color:#944D40;border:1px solid;padding:7px;background:#f7f3e9dd;writing-mode:vertical-rl;}.exploration-dock{position:relative;margin-top:-24px;background:#F7F3E9;border:1px solid #C5B18A;padding:18px 20px 20px;box-shadow:0 6px 20px #4c483314;}.home-intro{text-align:center;color:#566554;font-size:16px;margin-bottom:12px;}.home-meta{display:flex;gap:10px;justify-content:center;font-size:13px;color:#6A7266;margin-top:14px;}.learning-panel{padding:20px;}.chapter-total{font-size:30px;color:#315C4C;margin:5px 0 12px;}.chapter-total text{font-size:16px;color:#677061;}.learning-leaf{font:30px serif;color:#9A5147;border:1px solid #B39A70;padding:8px;}.home-links{display:flex;gap:12px;margin-top:18px;}.home-links button{flex:1;display:flex;align-items:center;gap:10px;background:#ECE8DA;padding:14px 10px;margin:0;width:auto;line-height:1.6;border:1px solid #D6C9AF;text-align:left;}.entry-icon{font:23px serif;color:#886D43;}.entry-title{font-size:16px;color:#333C39;}.arrow{display:none;}.home-links .small{font-size:12px;}.footer-note{margin-top:22px;}@media(max-width:350px){.home-hero{height:420px;}.hero-title .display{font-size:42px;}.entry-title{font-size:14px;}}@media(min-width:700px){.home-hero{height:550px;margin:0;}.hero-title{padding-top:30px;}.hero-title .display{font-size:60px;}.exploration-dock{width:520px;max-width:100%;margin:-24px auto 0;}.home-links{gap:24px;}}
