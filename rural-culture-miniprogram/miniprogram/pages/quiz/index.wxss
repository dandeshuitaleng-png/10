.quiz-meta{display:flex;justify-content:space-between;align-items:center;margin:8px 0 16px;}.question-number{font-size:32px;color:#315C4C;font-variant-numeric:tabular-nums;}.timer{font-size:14px;color:#315C4C;background:#E9EDE2;border-radius:6px;padding:5px 12px;}.urgent{color:#9A5147;background:#F3E7DF;}.question-card{margin-top:26px;}.question-type{margin-bottom:12px;}.question-text{font-size:23px;font-weight:500;line-height:1.65;}.question-media{display:block;width:100%;border-radius:10px;margin-top:18px;max-height:230px;}.options{display:flex;flex-direction:column;gap:12px;margin-top:24px;}.option{width:100%;padding:16px;min-height:64px;display:flex;gap:14px;align-items:center;text-align:left;margin:0;background:#FFFDF7;border:1px solid #DEDCCD;border-radius:10px;color:#333C39;line-height:1.65;}.option[disabled]{color:#333C39;background:#FFFDF7;}.option-letter{display:flex;align-items:center;justify-content:center;width:30px;height:30px;flex-shrink:0;background:#EEEDE3;border-radius:6px;font-size:16px;color:#66736C;}.option-text{flex:1;font-size:18px;}.selected,.selected[disabled]{border-color:#315C4C;background:#EAF0E6;}.selected .option-letter{background:#315C4C;color:white;}.option-check{color:#315C4C;font-size:14px;}.correct-option,.correct-option[disabled]{border-color:#315C4C;background:#EAF0E6;}.incorrect-option,.incorrect-option[disabled]{border-color:#9A5147;background:#F3E7DF;}.answer-feedback{background:#E8EDDF;border-radius:10px;padding:18px;margin-top:22px;}.feedback-title{color:#315C4C;font-size:17px;font-weight:600;margin-bottom:8px;}.action-error{color:#9A5147;font-size:15px;padding:12px 0;}.modal-mask{position:fixed;inset:0;background:rgba(31,46,37,.45);z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;}.revival-dialog{width:100%;max-width:410px;max-height:calc(100vh - 48px);overflow-y:auto;padding:28px 24px;background:#FFFDF7;border-radius:16px;text-align:center;}.dialog-mark{width:48px;height:48px;background:#F0E4D3;color:#76603A;border:1px solid #CBB997;border-radius:50%;margin:0 auto 18px;font-family:serif;font-size:25px;line-height:46px;}.dialog-intro{color:#66736C;font-size:15px;margin:12px 0;}.dialog-explanation{padding:16px;background:#F1EDE1;border-radius:8px;font-size:16px;line-height:1.7;text-align:left;margin:18px 0;}.share-button{margin:20px 0 12px;background:#315C4C;color:white;border-radius:10px;font-size:17px;line-height:1.5;padding:14px;min-height:52px;}.dialog-demo{font-size:12px;color:#66736C;line-height:1.7;margin-top:16px;}.quiz-page{max-width:760px;}

.option.option{width:100%;}
.share-button.share-button{width:100%;}
.option-text.option-text {color:#333C39;}
.option.option[disabled] {opacity:1;color:#333C39;background:#FFFDF7;}
.option.correct-option[disabled],.option.selected[disabled] {background:#EAF0E6;}
.option.incorrect-option[disabled] {background:#F3E7DF;}

.quiz-page{background:#EDE9DB;}.question-card{position:relative;margin-top:24px;padding:24px 20px;background:#FFFBF0;border:1px solid #C8B899;border-bottom:0;box-shadow:0 3px 18px #51472E0c;}.question-card::before{content:'问';position:absolute;top:-12px;right:18px;color:#9A5147;background:#FFFBF0;padding:0 6px;border:1px solid #B99B76;font:17px serif;}.question-text{font-size:22px;}.reading-sheet{padding:0 20px 24px;background:#FFFBF0;border:1px solid #C8B899;border-top:0;box-shadow:0 10px 20px #51472E12;}.options{margin-top:0;padding-top:20px;gap:12px;}.option.option{border-radius:4px;padding:15px 14px;min-height:66px;}.option-letter{border-radius:2px;border:1px solid #B5A482;background:#F1E9D7;}.question-type{font-size:13px;}.quiz-meta{border-top:1px solid #C6B99E;padding-top:16px;}.timer{border:1px solid #B6C1A6;background:#E5ECD9;border-radius:3px;}.revival-dialog{border:1px solid #A58D60;border-radius:6px;box-shadow:0 0 0 5px #F7F3E9;}.dialog-explanation{border-radius:3px;background:#EEE6D3;}.share-button{border:1px solid #B39A70;border-radius:4px;}.answer-feedback{border-radius:3px;border-left:3px solid #315C4C;}@media(max-width:350px){.question-card{padding:20px 16px;}.reading-sheet{padding:0 16px 20px;}.option-text{font-size:17px;}}
