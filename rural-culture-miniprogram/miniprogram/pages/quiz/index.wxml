<view class="page quiz-page"><view class="topbar"><button class="back" bindtap="leave">‹ 返回主题</button><text class="tiny-label">知识探索</text></view><page-state loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{session && !loading && !error}}"><view class="eyebrow" style="color:{{session.theme.color}}">{{session.theme.name}} · {{session.chapter.title}}</view><view class="quiz-meta"><view><text class="question-number">{{session.position < 10 ? '0' + session.position : session.position}}</text><text class="small"> / {{session.total}} 题</text></view><view class="timer {{remaining <= 10 ? 'urgent' : ''}}">{{session.status === 'answering' ? '剩余 ' + remaining + ' 秒' : '已提交回答'}}</view></view><study-progress value="{{session.position / session.total * 100}}" color="{{session.theme.color}}"/><view class="question-card fade"><view class="small question-type">单项选择 · 选出你认为正确的一项</view><view class="question-text">{{session.question.text}}</view><image wx:if="{{session.question.media && session.question.media.type === 'image'}}" class="question-media" src="{{session.question.media.src}}" mode="widthFix" aria-label="{{session.question.media.alt}}" binderror="mediaFailed"/><video wx:if="{{session.question.media && session.question.media.type === 'video'}}" class="question-media" src="{{session.question.media.src}}" controls="{{true}}" binderror="mediaFailed"/></view>
<view class="reading-sheet"><view class="options"><button class="option {{selected === item.id ? 'selected' : ''}} {{feedback && feedback.correctOptionId === item.id ? 'correct-option' : ''}} {{feedback && !feedback.correct && selected === item.id ? 'incorrect-option' : ''}}" wx:for="{{session.question.options}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" disabled="{{busy || session.status !== 'answering'}}"><text class="option-letter">{{item.label}}</text><text class="option-text">{{item.text}}</text><text class="option-check" wx:if="{{feedback && feedback.correctOptionId === item.id}}">✓</text><text class="option-check" wx:elif="{{selected === item.id}}">●</text></button></view>
<view class="answer-feedback" wx:if="{{feedback && feedback.correct}}"><view class="feedback-title">回答正确</view><view class="body">{{feedback.explanation}}</view></view><view class="action-error" wx:if="{{actionError}}">{{actionError}}</view><view class="button-stack"><ui-button class="action-button" wx:if="{{session.status === 'answering'}}" label="提交答案" disabled="{{!selected && remaining > 0}}" busy="{{busy}}" bind:action="submit"/><ui-button class="action-button" wx:elif="{{session.status === 'reviewing'}}" label="{{session.position === session.total ? '查看本章学习成果' : '继续下一题'}}" busy="{{busy}}" bind:action="next"/></view></view><view class="footer-note">读懂解析，比记住答案更重要。</view>
<view class="modal-mask" wx:if="{{showRevival}}" catchtouchmove="noop"><view class="revival-dialog"><view class="dialog-mark">读</view><view class="h2">{{session.status === 'locked' ? '今天先读到这里' : '本次回答未通过'}}</view><view class="dialog-intro">{{feedback.timedOut ? '本题作答时间已结束。' : '再读一读解析，让知识更清晰。'}}</view><view class="dialog-explanation">{{feedback.explanation}}</view><view class="small">{{session.status === 'locked' ? '今日继续学习次数已用完，明天可以重新探索。' : '剩余复活次数：' + session.remainingRevivals + ' 次'}}</view><view class="action-error" wx:if="{{actionError}}">{{actionError}}</view><button wx:if="{{session.status === 'revival'}}" id="revival-share" class="share-button" open-type="share" disabled="{{busy}}" loading="{{busy}}">分享并继续学习</button><ui-button class="action-button" variant="secondary" label="返回主题" bind:action="back"/><view class="dialog-demo" wx:if="{{session.status === 'revival'}}">演示模式：分享返回后，由模拟服务确认资格。</view></view></view></block></view>
