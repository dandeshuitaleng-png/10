<view class="page ranking-page"><view class="topbar"><button class="back" bindtap="home">‹ 首页</button><text class="tiny-label">学习成果</text></view><view class="eyebrow">一起阅读，一起成长</view><view class="heading">学习积分榜</view><view class="intro">每一份积分，都来自一次认真探索。</view><view class="tabs"><button class="{{scope === 'daily' ? 'active' : ''}}" data-scope="daily" bindtap="switchTab">每日积分榜</button><button class="{{scope === 'total' ? 'active' : ''}}" data-scope="total" bindtap="switchTab">总积分榜</button></view><page-state loading="{{loading}}" error="{{error}}" empty="{{board && board.rows.length === 0}}" message="榜单还没有学习记录。开启探索，留下第一份收获。" bind:retry="refresh"/><block wx:if="{{board && !loading && !error}}"><view class="ranking-caption"><text>{{scope === 'daily' ? board.date : '累计学习成果'}}</text><text wx:if="{{board.isDemo}}">演示榜单</text></view><view class="ranking-table"><view class="rank-header"><text>排名</text><text>学习者</text><text>积分</text></view><view class="rank-row {{item.isMe ? 'me' : ''}}" wx:for="{{board.rows}}" wx:key="id"><text class="rank-number">{{item.rank < 10 ? '0' + item.rank : item.rank}}</text><view class="rank-name"><view class="avatar">{{item.name[0]}}</view><text>{{item.name}}</text><text class="me-tag" wx:if="{{item.isMe}}">我</text></view><text class="rank-points">{{item.points}}</text></view></view><view class="my-rank" wx:if="{{board.me}}"><view class="small">我的{{scope === 'daily' ? '今日' : '累计'}}成果</view><view class="row"><text>第 {{board.me.rank}} 名</text><text class="my-points">{{board.me.points}} <text>积分</text></text></view></view></block><view class="footer-note">以阅读相伴，让成长被看见。</view></view>
