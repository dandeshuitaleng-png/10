.tabs{display:flex;gap:4px;padding:4px;background:#E8EADF;border-radius:10px;margin-bottom:24px;}.tabs button{flex:1;background:transparent;border-radius:7px;margin:0;padding:11px 4px;min-height:48px;font-size:16px;color:#66736C;line-height:1.5;}.tabs .active{color:#315C4C;background:#FFFDF7;font-weight:500;}.ranking-caption{display:flex;justify-content:space-between;color:#66736C;font-size:13px;margin:16px 0;}.rank-header,.rank-row{display:grid;grid-template-columns:42px minmax(0,1fr) 52px;align-items:center;gap:10px;padding:18px 0;border-bottom:1px solid #DEDCCD;}.rank-header{font-size:13px;color:#66736C;padding-top:10px;}.rank-header>text:last-child{text-align:right;}.rank-number{font-size:17px;color:#66736C;}.rank-name{display:flex;align-items:center;gap:10px;font-size:16px;}.rank-name>text{overflow-wrap:anywhere;}.avatar{width:32px;height:34px;background:#E7E8DA;border-radius:8px;color:#536C5A;line-height:34px;text-align:center;font-family:serif;flex-shrink:0;}.rank-points{font-size:19px;color:#315C4C;text-align:right;}.me{background:#EDF0E955;}.me-tag{font-size:12px;color:#315C4C;white-space:nowrap;}.my-rank{padding:18px 20px;border:1px solid #B9C4AF;border-radius:12px;background:#EAEFDF;margin-top:28px;}.my-rank .row{margin-top:6px;font-size:18px;}.my-points{font-size:26px;color:#315C4C;}.my-points text{font-size:14px;}

.tabs button{width:auto;} 
