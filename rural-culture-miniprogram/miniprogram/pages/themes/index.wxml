<view class="page"><view class="topbar"><button class="back" bindtap="home">‹ 首页</button><text class="tiny-label">文化专题</text></view><view class="eyebrow">读懂湖南，从一段探索开始</view><view class="heading">四季乡土，四卷书香</view><view class="intro">选一卷感兴趣的文化读本，<br/>沿着章节慢慢读，也细细想。</view><page-state loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && themes.length === 0}}" bind:retry="refresh"/>
<view class="theme-grid fade" wx:if="{{!loading && !error}}"><view class="theme-card" wx:for="{{themes}}" wx:key="id"><image class="theme-art" src="{{item.image}}" mode="aspectFill" aria-label="{{item.subtitle}}"/><view class="theme-content"><view class="row"><view class="h2" style="color:{{item.color}}">{{item.name}}</view><text class="theme-tag" style="color:{{item.color}}">{{item.tag}}</text></view><view class="theme-description">{{item.description}}</view><view class="theme-bottom"><view class="theme-progress"><study-progress value="{{item.completedCount / item.totalChapters * 100}}" color="{{item.color}}"/><text class="small">已完成 {{item.completedCount}} / {{item.totalChapters}} 章</text></view><button class="theme-enter" style="color:{{item.color}};border-color:{{item.color}}" data-id="{{item.id}}" bindtap="enter">进入主题 →</button></view></view></view></view><view class="footer-note">每一次阅读，都是与家乡的重新相遇。</view></view>
