.theme-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;}.theme-card{position:relative;background:#F2EBD9;border:1px solid #BFA981;box-shadow:0 5px 15px #4b493012;overflow:hidden;}.theme-art{width:100%;height:240px;display:block;}.theme-content{padding:18px 20px 20px;position:relative;border-top:1px solid #C9B894;background:#F8F2E4;}.theme-content .h2{font:26px 'Songti SC',serif;letter-spacing:2px;font-weight:600;}.theme-tag{font-size:12px;border:1px solid #BDA887;padding:3px 6px;}.theme-description{font-size:15px;color:#5C685B;margin:8px 0 14px;}.theme-bottom{display:flex;align-items:center;gap:16px;}.theme-progress{flex:1;min-width:0;}.theme-progress .small{display:block;margin-top:7px;}.theme-enter.theme-enter{width:auto;min-width:0;margin:0;padding:13px 14px;background:#315C4C;color:#FFFDF7!important;border:1px solid #B39A70!important;border-radius:5px;font-size:15px;line-height:1.5;min-height:48px;}.theme-card::before{content:'';position:absolute;z-index:1;inset:7px;border:1px solid #F7F3E966;pointer-events:none;}@media(min-width:700px){.theme-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.theme-art{height:270px;}}@media(max-width:350px){.theme-art{height:210px;}.theme-content{padding:16px;}.theme-enter.theme-enter{padding:12px 10px;font-size:14px;}}
