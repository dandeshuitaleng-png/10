.chapter-hero{position:relative;text-align:center;padding-top:4px;}.chapter-art{height:190px;width:100%;display:block;margin-bottom:18px;border:1px solid #BFA981;}.chapter-list{position:relative;padding:22px 14px 34px;overflow:hidden;min-height:610px;border:1px solid #B39A70;background:#DFE8D4;}.route-art{position:absolute;inset:0;width:100%;height:100%;opacity:.7;}.route-heading{position:relative;text-align:center;font:18px serif;color:#315C4C;background:#F7F3E9ed;padding:12px;border-top:1px solid #B39A70;border-bottom:1px solid #B39A70;margin-bottom:28px;}.chapter-item.chapter-item{position:relative;display:flex;align-items:center;gap:12px;text-align:left;line-height:1.6;width:94%;min-height:106px;margin:0 0 24px;padding:16px 14px;background:#FFF8E9f5;border:1px solid #AB956E;border-radius:3px;box-shadow:0 5px 12px #30453620;}.chapter-item:nth-of-type(even){margin-left:6%;}.chapter-index{font:28px serif;width:36px;height:46px;text-align:center;line-height:44px;border:1px solid #B39A70;flex-shrink:0;}.chapter-copy{flex:1;min-width:0;}.chapter-title{font:20px serif;color:#333C39;margin-bottom:6px;}.chapter-status{display:block;font-size:12px;color:#315C4C;margin-top:6px;}.chapter-end{font-size:17px;color:#315C4C;flex-shrink:0;}.locked .chapter-end{font-size:11px;color:#677061;}.locked{background:#F0ECE1f0;}.available{outline:2px solid #315C4C;outline-offset:3px;}.completed .chapter-index{background:#315C4C;color:#FFFDF7!important;}.chapter-list .small{font-size:12px;}@media(min-width:700px){.chapter-art{height:260px;}.chapter-list{max-width:600px;margin:auto;}.chapter-item.chapter-item{min-height:110px;}}@media(max-width:350px){.chapter-item.chapter-item{gap:8px;padding:14px 10px;}.chapter-index{width:28px;font-size:22px;}}
