<view class="page"><view class="topbar"><button class="back" bindtap="topics">‹ 文化专题</button><text class="tiny-label">章节目录</text></view><page-state loading="{{loading}}" error="{{error}}" bind:retry="refresh"/><block wx:if="{{theme && !loading && !error}}"><view class="chapter-hero fade"><image class="chapter-art" src="{{theme.image}}" mode="aspectFill"/><view class="eyebrow" style="color:{{theme.color}}">{{theme.subtitle}}</view><view class="heading" style="color:{{theme.color}}">{{theme.name}}</view><view class="intro">{{theme.description}}</view></view><study-progress value="{{theme.completedCount / theme.totalChapters * 100}}" color="{{theme.color}}" label="已完成 {{theme.completedCount}} / {{theme.totalChapters}} 章"/><view class="note" wx:if="{{theme.dailyLocked}}">今天的学习挑战已暂停。明天回来，可以继续探索。</view><view class="section-head"><text class="h2">探索路线</text><text class="small">依次阅读探索</text></view><view class="chapter-list"><image class="route-art" src="{{theme.image}}" mode="aspectFill"/><view class="route-heading">{{theme.name}} · 探索画卷</view><button class="chapter-item {{item.status}}" wx:for="{{theme.chapters}}" wx:key="id" data-id="{{item.id}}" bindtap="enter"><view class="chapter-index" style="color:{{theme.color}}">{{item.order}}</view><view class="chapter-copy"><view class="chapter-title">{{item.title}}</view><view class="small">{{item.questionCount}} 道知识题 · {{item.points}} 学习积分</view><text class="chapter-status">{{item.status === 'completed' ? '已完成 · 可再次阅读' : item.status === 'available' ? '可开始探索' : '完成前一章后开启'}}</text></view><text class="chapter-end">{{item.status === 'completed' ? '✓' : item.status === 'available' ? '→' : '未解锁'}}</text></button></view><view class="note">用阅读认识乡村，用答题巩固所学。答题后可查看知识解析。</view><ui-button class="action-button" wx:if="{{theme.completedCount === theme.totalChapters}}" variant="secondary" label="查看主题学习证书" bind:action="certificate"/><view class="footer-note">不赶路，读好每一章。</view></block></view>
