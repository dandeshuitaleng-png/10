<view class="page certificate-page"><view class="topbar"><button class="back" bindtap="home">‹ 首页</button><text class="tiny-label">学习记录</text></view><view class="eyebrow">让每一段探索，都有回响</view><view class="heading">我的学习证书</view><view class="intro">完成主题章节，收下一份属于你的文化印记。</view><view class="certificate-tabs"><button class="{{group === 'theme' ? 'active' : ''}}" data-group="theme" bindtap="switchTab">主题证书</button><button class="{{group === 'all' ? 'active' : ''}}" data-group="all" bindtap="switchTab">总证书</button></view><page-state loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !certificate}}" message="{{group === 'all' ? '完成四个主题的全部章节后，可获得总学习证书。' : '完成一个主题的全部章节后，你的电子证书将在这里保存。'}}" bind:retry="refresh"/><block wx:if="{{certificate && !loading && !error}}"><view class="certificate-selector" wx:if="{{visible.length > 1}}"><button class="{{certificate.id === item.id ? 'selected' : ''}}" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="select">{{item.title}}</button></view><view class="certificate-paper fade"><view class="paper-inner"><view class="certificate-brand">湖南数字农家书屋</view><view class="certificate-title">学习证书</view><view class="certificate-name">{{certificate.title}}</view><view class="recipient">{{certificate.name}}</view><view class="certificate-copy">{{certificate.description}}</view><view class="certificate-date">完成日期 {{certificate.date}}</view><view class="certificate-code">证书编号 {{certificate.number}}</view><view class="certificate-seal">书屋</view><view class="certificate-footer">特色乡村资源荟 · 乡村文化知识探索</view></view><image class="certificate-art" src="/assets/v2/landscape.jpg" mode="aspectFill"/></view><view class="button-stack"><ui-button class="action-button" label="保存学习证书" busy="{{saving}}" bind:action="save"/><button class="certificate-share" open-type="share">分享学习成果</button></view><canvas id="certificate-canvas" type="2d" class="export-canvas"/></block><ui-button class="action-button" wx:if="{{!certificate && !loading && !error}}" label="继续文化探索" bind:action="explore"/><view class="footer-note">阅读有收获，成长有记录。</view></view>
