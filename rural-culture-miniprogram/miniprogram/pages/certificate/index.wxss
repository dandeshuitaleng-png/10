.certificate-page{max-width:720px;}.certificate-tabs{display:flex;gap:4px;background:#E8EADF;padding:4px;border-radius:10px;margin:18px 0 24px;}.certificate-tabs button{margin:0;flex:1;min-height:48px;background:transparent;padding:12px 8px;border-radius:7px;color:#66736C;font-size:16px;line-height:1.5;}.certificate-tabs .active{background:#FFFDF7;color:#315C4C;font-weight:500;}.certificate-paper{position:relative;border:1px solid #B39A70;padding:7px;background:#F5F0E2;overflow:hidden;}.paper-inner{position:relative;z-index:1;border:1px solid #CAB892;padding:28px 20px 32px;text-align:center;}.certificate-brand{font-size:13px;color:#315C4C;letter-spacing:2px;}.certificate-title{font-family:"Songti SC",serif;font-size:34px;letter-spacing:5px;color:#76603A;margin:20px 0 12px;}.certificate-name{font-size:15px;color:#76603A;line-height:1.7;}.recipient{font-size:23px;color:#333C39;line-height:1.6;margin:32px 0 18px;font-weight:500;}.certificate-copy{font-size:16px;color:#66736C;line-height:1.9;}.certificate-date{font-size:13px;color:#66736C;margin-top:28px;}.certificate-code{font-size:12px;color:#66736C;margin-top:5px;}.certificate-seal{width:50px;height:50px;border:1px solid #9A5147;border-radius:50%;color:#9A5147;line-height:48px;font-family:serif;font-size:20px;margin:24px auto 18px;}.certificate-footer{font-size:12px;color:#315C4C;letter-spacing:1px;}.certificate-art{position:absolute;bottom:0;left:0;right:0;width:100%;height:120px;opacity:.2;}.certificate-share{width:100%;margin:0;padding:13px;border:1px solid #315C4C;border-radius:10px;background:transparent;color:#315C4C;font-size:17px;line-height:1.5;min-height:52px;}.export-canvas{position:fixed;left:-9999px;width:900px;height:1200px;}.certificate-selector{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px;}.certificate-selector button{font-size:14px;line-height:1.6;min-height:44px;margin:0;background:#E8EADF;color:#66736C;padding:10px;border-radius:6px;}.certificate-selector .selected{background:#315C4C;color:white;}

.certificate-share.certificate-share{width:100%;}.certificate-tabs button,.certificate-selector button{width:auto;}
