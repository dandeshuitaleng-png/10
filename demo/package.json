{
  "name": "rural-quiz-minigame",
  "version": "0.3.0",
  "private": true,
  "description": "趣味闯关：可配置主题关卡、题数、复活、积分日上限、证书与后台",
  "scripts": {
    "content:import": "node scripts/import-question-bank.cjs --install",
