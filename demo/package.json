    "design:render": "node scripts/render-design.cjs",
    "start": "node server/start.cjs",
    "test:server": "node --test tests/server*.test.cjs",
    "test:game": "node scripts/verify-full-game.cjs",
    "test:media": "node scripts/verify-game-media.cjs",
    "test:recovery": "node scripts/verify-backup-recovery.cjs",
    "data:check": "node scripts/maintain-data.cjs check",
