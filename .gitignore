# Only this project's maintained source and current independent deliveries are versioned.
/*
!/.gitignore
!/README.md
!/BASELINE_VERSION.md
!/*.command
!/rural-culture-miniprogram/
!/demo/
!/quiz-admin/
!/交付/
/交付/*
!/交付/微信小程序四套/
!/交付/证书样式修订-20261021/

# Local data, credentials, dependencies and generated archives.
**/.DS_Store
**/node_modules/
**/dist/
**/.env
**/.env.*
!**/.env.example
**/project.private.config.json
**/server/data/
**/.rural-quiz-runtime/
**/.admin-credentials.json
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.p12
**/*.mobileprovision
**/*.zip
**/*.mp4
**/*.mov
**/*.log
**/__pycache__/
**/.pytest_cache/
**/delivery-remote/
**/qa-v4/
**/native-events.json
**/native-last-operation.json
**/native-error.txt

# Preserve current evidence, not hundreds of megabytes of old review captures.
/rural-culture-miniprogram/qa/*
!/rural-culture-miniprogram/qa/certificate-20261021/
!/rural-culture-miniprogram/qa/interaction-20261021/
!/rural-culture-miniprogram/qa/home-designs-20261021/
/rural-culture-miniprogram/qa/interaction-20261021/baseline/
